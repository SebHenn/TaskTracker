<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFAC010 tells WinForms apps to declare DPI awareness via
         ApplicationHighDpiMode instead of the manifest. That property only takes
         effect through ApplicationConfiguration.Initialize(), which a WPF host
         never calls — WPF reads DPI awareness from the manifest. UseWindowsForms
         is on solely for the tray icon, so the analyzer's premise doesn't hold. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms adds these as implicit global usings, which makes every
         bare WPF type (Control, UserControl, Application, Point…) ambiguous.
         TrayService fully qualifies its WinForms types instead. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskTracker.Core\TaskTracker.Core.csproj" />
  </ItemGroup>

  <!-- The nine 32px icon PNGs that used to be listed here are gone: Styles/Icons.xaml
       carries them as geometry instead, which stays sharp at every scale factor and
       takes its colour from the control. app.ico stays — a window icon has to be a
       real icon file. -->

</Project>
