<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light palette. Must define exactly the same keys as DarkMode/ColorsDark.xaml —
         a key that exists in only one theme fails silently until someone switches. -->

    <!-- ==== Surface ramp ====
         Mirror of dark: elevation moves away from the canvas. Here that means towards
         white, so the sidebar is the tinted step and cards are pure white. -->
    <Color x:Key="Color.Surface.Base">#FFEDEDF0</Color>
    <Color x:Key="Color.Surface.Raised">#FFF7F7F9</Color>
    <Color x:Key="Color.Surface.Card">#FFFFFFFF</Color>
    <Color x:Key="Color.Surface.Overlay">#FFFFFFFF</Color>

    <SolidColorBrush x:Key="Brush.Surface.Base" Color="{StaticResource Color.Surface.Base}" />
    <SolidColorBrush x:Key="Brush.Surface.Raised" Color="{StaticResource Color.Surface.Raised}" />
    <SolidColorBrush x:Key="Brush.Surface.Card" Color="{StaticResource Color.Surface.Card}" />
    <SolidColorBrush x:Key="Brush.Surface.Overlay" Color="{StaticResource Color.Surface.Overlay}" />

    <SolidColorBrush x:Key="Brush.Window.Background" Color="{StaticResource Color.Surface.Base}" />
    <SolidColorBrush x:Key="Brush.Content.Background" Color="{StaticResource Color.Surface.Raised}" />
    <SolidColorBrush x:Key="Brush.Card.Background" Color="{StaticResource Color.Surface.Card}" />

    <!-- ==== Text ==== -->
    <Color x:Key="Color.Text.Primary">#FF1A1A1F</Color>
    <Color x:Key="Color.Text.Secondary">#FF5C5C66</Color>
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="#FF74747F" />
    <SolidColorBrush x:Key="Brush.Text.OnCard" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Text.Hint" Color="#FF9A9AA4" />

    <!-- ==== Lines ==== -->
    <SolidColorBrush x:Key="Brush.Divider" Color="#14000000" />
    <SolidColorBrush x:Key="Brush.Border" Color="#FFD6D6DC" />
    <!-- Cards are white on a near-white canvas, so the border is what separates them. -->
    <SolidColorBrush x:Key="Brush.Card.Border" Color="#FFE0E0E7" />

    <!-- ==== Accent ====
         One blue does both jobs here: it is already dark enough for hairlines on a
         light canvas and carries white text at 7.9:1. -->
    <Color x:Key="Color.Accent">#FF1D45BF</Color>
    <Color x:Key="Color.Accent.Strong">#FF1D45BF</Color>
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Accent.Strong" Color="{StaticResource Color.Accent.Strong}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#FF2450D6" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#FF17389C" />

    <SolidColorBrush x:Key="Brush.Danger" Color="#FFC0392B" />
    <SolidColorBrush x:Key="Brush.Danger.Text" Color="#FFB3261E" />

    <SolidColorBrush x:Key="Brush.Priority.Low" Color="#FF2E7D32" />
    <!-- Darker than it looks like it wants to be: orange on white is the one priority
         edge that struggles to clear 3:1, and #E07A00 landed at 3.02 with no margin. -->
    <SolidColorBrush x:Key="Brush.Priority.Medium" Color="#FFC96A00" />
    <SolidColorBrush x:Key="Brush.Priority.High" Color="#FFD32F2F" />

    <!-- ==== Interaction ==== -->
    <SolidColorBrush x:Key="Brush.State.Hover" Color="#0D000000" />
    <SolidColorBrush x:Key="Brush.State.Pressed" Color="#1A000000" />
    <SolidColorBrush x:Key="Brush.State.Selected" Color="#1F1D45BF" />
    <SolidColorBrush x:Key="Brush.Focus.Visual" Color="{StaticResource Color.Accent.Strong}" />

    <SolidColorBrush x:Key="Brush.Chip.Background" Color="#14000000" />
    <SolidColorBrush x:Key="Brush.Chip.Border" Color="#1F000000" />

    <SolidColorBrush x:Key="Brush.Button.Flat.Background" Color="Transparent" />
    <SolidColorBrush x:Key="Brush.Button.Flat.Hover" Color="#0D000000" />
    <SolidColorBrush x:Key="Brush.Button.Flat.Pressed" Color="#1A000000" />
    <SolidColorBrush x:Key="Brush.Button.Close.Hover" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="Brush.Button.Close.Pressed" Color="#FFA82419" />
    <SolidColorBrush x:Key="Brush.Button.Solid.Background" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Button.Solid.Hover" Color="#FFF1F1F4" />
    <SolidColorBrush x:Key="Brush.Button.Solid.Pressed" Color="#FFE4E4EA" />
    <SolidColorBrush x:Key="Brush.Button.Foreground" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Indicator" Color="{StaticResource Color.Accent.Strong}" />

    <SolidColorBrush x:Key="Brush.ScrollBar.Thumb" Color="#FFC2C2CA" />

    <SolidColorBrush x:Key="Brush.TextBox.Background" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.TextBox.Border" Color="#FFD6D6DC" />
    <SolidColorBrush x:Key="Brush.TextBox.Foreground" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.TextBox.Selection" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.TextBox.Border.Hover" Color="#FFAFAFB8" />
    <SolidColorBrush x:Key="Brush.TextBox.Border.Focus" Color="{StaticResource Color.Accent}" />

</ResourceDictionary>
