<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:TaskTracker.Helpers"
                    xmlns:models="clr-namespace:TaskTracker.Core.Models;assembly=TaskTracker.Core">

    <!-- Theme-independent resources; colors come from the active theme's semantic brushes. -->

    <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

    <Style x:Key="TaskChip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Chip.Background}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="Margin" Value="0,4,4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TaskChipText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnCard}" />
    </Style>

    <!-- The task card used by both board columns (and any future task list). -->
    <DataTemplate x:Key="TaskCardTemplate" DataType="{x:Type models:TaskModel}">
        <Border Margin="5" Padding="10" CornerRadius="3" BorderThickness="4,0,0,0"
                Background="{DynamicResource Brush.Card.Background}"
                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Priority.Medium}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Priority}" Value="Low">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Priority.Low}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Priority}" Value="High">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Priority.High}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="Black" Opacity="0.3" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.OnCard}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Description}" FontSize="14" Foreground="{DynamicResource Brush.Text.OnCard}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Description}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <WrapPanel>
                    <!-- Due date chip; highlighted when overdue -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource TaskChip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DueDate}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Style="{StaticResource TaskChipText}" Text="{Binding DueDate, StringFormat={}📅 {0:d}}" />
                    </Border>
                    <!-- Linked GitHub issue chip -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource TaskChip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GitHubIssueNumber}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Style="{StaticResource TaskChipText}" Text="{Binding GitHubIssueNumber, StringFormat={}#{0}}" />
                    </Border>
                    <!-- Label chips -->
                    <ItemsControl ItemsSource="{Binding Labels}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TaskChip}">
                                    <TextBlock Style="{StaticResource TaskChipText}" Text="{Binding}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>
            </StackPanel>
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Mark as Done"
                              Command="{Binding PlacementTarget.Tag.MarkAsDoneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding}"
                              Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=False}" />
                    <MenuItem Header="Mark as In Progress"
                              Command="{Binding PlacementTarget.Tag.MarkAsInProgressCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding}"
                              Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}" />
                    <MenuItem Header="Edit Task"
                              Command="{Binding PlacementTarget.Tag.EditTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding}" />
                    <MenuItem Header="Delete Task"
                              Command="{Binding PlacementTarget.Tag.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding}" />
                </ContextMenu>
            </Border.ContextMenu>
        </Border>
    </DataTemplate>

</ResourceDictionary>
