<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:TaskTracker.Helpers"
                    xmlns:models="clr-namespace:TaskTracker.Core.Models;assembly=TaskTracker.Core">

    <!-- Typography is merged here as well as in App.xaml, and it has to be: the chip
         and card styles below derive from Text.Caption and Text.BodyStrong via BasedOn,
         and BasedOn is resolved at parse time. A StaticResource inside a merged
         dictionary can only see keys from its own file or from dictionaries merged into
         it — being siblings under App.xaml is not enough — and BasedOn cannot fall back
         to DynamicResource. Without this the first card to render throws.
         Merging by the same URI is cheap: WPF caches the dictionary instance. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Theme-independent resources; colors come from the active theme's semantic brushes. -->

    <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <helpers:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
    <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    <helpers:NullableIntConverter x:Key="NullableIntConverter" />
    <helpers:ColorStringToBrushConverter x:Key="ColorStringToBrushConverter" />
    <helpers:SidebarWidthConverter x:Key="SidebarWidthConverter" />
    <helpers:UtcToLocalConverter x:Key="UtcToLocalConverter" />

    <!-- A chip is a token, not a button: bordered rather than filled, so a row of them
         does not read as a row of things to click. -->
    <Style x:Key="TaskChip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Chip.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Chip.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Chip}" />
        <Setter Property="Padding" Value="{DynamicResource Pad.Chip}" />
        <Setter Property="Margin" Value="0,6,4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TaskChipText" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
    </Style>

    <!-- The task card used by the board columns.

         Rebuilt around one question: what has to be legible from across the board?
         Title, how urgent, and how far along. Everything else — description, notes,
         timestamps, the full checklist — lives in the detail drawer, which is a click
         away and does not cost every other card vertical space. The description is the
         card's tooltip so it stays reachable without being on screen permanently. -->
    <DataTemplate x:Key="TaskCardTemplate" DataType="{x:Type models:TaskModel}">
        <Border x:Name="Card" Margin="0,0,0,6"
                CornerRadius="{DynamicResource Radius.Card}"
                Background="{DynamicResource Brush.Card.Background}"
                BorderBrush="{DynamicResource Brush.Card.Border}"
                BorderThickness="1"
                AutomationProperties.Name="{Binding Title}"
                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="ToolTip" Value="{Binding Description}" />
                    <Style.Triggers>
                        <!-- An empty tooltip would still pop an empty box. -->
                        <DataTrigger Binding="{Binding Description}" Value="">
                            <Setter Property="ToolTip" Value="{x:Null}" />
                        </DataTrigger>
                        <!-- Hover lifts the card rather than tinting it: the priority edge
                             and label chips already own colour on this surface. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.28" Color="Black" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Completed work recedes without disappearing. -->
                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                            <Setter Property="Opacity" Value="0.65" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Priority as an edge, not a fill. Every card used to be CadetBlue,
                     which meant colour carried no information at all. -->
                <Border Grid.Column="0" CornerRadius="2,0,0,2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Brush.Priority.Medium}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Priority}" Value="Low">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Priority.Low}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Priority}" Value="High">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Priority.High}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <StackPanel Grid.Column="1">
                    <!-- Density comes from the board's view model, reached through the
                         hosting page the same way the context menu commands are. -->
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Margin" Value="10,8,10,10" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="Margin" Value="8,5,8,6" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Clamped to two lines: a long title stays scannable and cannot
                         push the rest of the column off screen. MaxHeight plus trimming
                         is how WPF ellipsizes wrapped text — there is no MaxLines.
                         Compact gives it one line. -->
                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.BodyStrong}">
                                <Setter Property="MaxHeight" Value="40" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="MaxHeight" Value="20" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <WrapPanel>
                        <!-- Due date. Overdue turns the whole chip, so it reads before
                             the date itself does. -->
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource TaskChip}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DueDate}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding DueDate, StringFormat={}{0:d}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TaskChipText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- Checklist progress, the one number that says "in flight". -->
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource TaskChip}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SubTaskProgress}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Style="{StaticResource TaskChipText}" Text="{Binding SubTaskProgress}" />
                        </Border>

                        <!-- Recurring. Spelled out and localized rather than an emoji
                             glyph, which picks up a colour font and ignores the theme. -->
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource TaskChip}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRecurring}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Style="{StaticResource TaskChipText}" Text="{DynamicResource RecurringChip}" />
                        </Border>

                        <!-- Linked GitHub issue -->
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource TaskChip}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GitHubIssueNumber}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Style="{StaticResource TaskChipText}" Text="{Binding GitHubIssueNumber, StringFormat={}#{0}}" />
                        </Border>

                        <!-- Labels last: user vocabulary, so it varies most in width. -->
                        <ItemsControl ItemsSource="{Binding Labels}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TaskChip}">
                                        <TextBlock Style="{StaticResource TaskChipText}" Text="{Binding}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>
                </StackPanel>
            </Grid>

            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{DynamicResource MarkAsDone}" InputGestureText="Ctrl+Right"
                              Command="{Binding PlacementTarget.Tag.MarkAsDoneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding}"
                              Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=False}" />
                    <MenuItem Header="{DynamicResource MarkAsInProgress}"
                              Command="{Binding PlacementTarget.Tag.MarkAsInProgressCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding}"
                              Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}" />
                    <MenuItem Header="{DynamicResource EditTask}" InputGestureText="Enter"
                              Command="{Binding PlacementTarget.Tag.EditTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding}" />
                    <MenuItem Header="{DynamicResource CreateGitHubIssue}"
                              Command="{Binding PlacementTarget.Tag.PushTaskToGitHubCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding}"
                              Visibility="{Binding GitHubIssueNumber, Converter={StaticResource NullToVisibilityConverter}}" />
                    <MenuItem Header="{DynamicResource DeleteTask}" InputGestureText="Del"
                              Command="{Binding PlacementTarget.Tag.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding}" />
                </ContextMenu>
            </Border.ContextMenu>
        </Border>
    </DataTemplate>

</ResourceDictionary>
