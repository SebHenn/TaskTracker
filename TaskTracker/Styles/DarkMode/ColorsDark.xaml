<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark palette. LightMode/ColorsLight.xaml defines the same keys; all control
         templates live in Styles/Controls and reference these via DynamicResource, so
         swapping the palette swaps the theme.

         Colours are declared once and the semantic brushes point at them, so a surface
         and its aliases cannot drift apart. -->

    <!-- ==== Surface ramp ====
         The canvas is darkest and every step up in elevation gets lighter. The old
         palette had this inverted: the sidebar (#383333) sat lighter than the content
         area (#1D1B1B), so the chrome read as floating in front of the actual work. -->
    <Color x:Key="Color.Surface.Base">#FF17171A</Color>
    <Color x:Key="Color.Surface.Raised">#FF1F1F23</Color>
    <Color x:Key="Color.Surface.Card">#FF27272C</Color>
    <Color x:Key="Color.Surface.Overlay">#FF2E2E35</Color>

    <SolidColorBrush x:Key="Brush.Surface.Base" Color="{StaticResource Color.Surface.Base}" />
    <SolidColorBrush x:Key="Brush.Surface.Raised" Color="{StaticResource Color.Surface.Raised}" />
    <SolidColorBrush x:Key="Brush.Surface.Card" Color="{StaticResource Color.Surface.Card}" />
    <SolidColorBrush x:Key="Brush.Surface.Overlay" Color="{StaticResource Color.Surface.Overlay}" />

    <!-- Named for where they are used; same values as the ramp above. -->
    <SolidColorBrush x:Key="Brush.Window.Background" Color="{StaticResource Color.Surface.Base}" />
    <SolidColorBrush x:Key="Brush.Content.Background" Color="{StaticResource Color.Surface.Raised}" />
    <!-- Cards were CadetBlue #5F9EA0 — every card, regardless of what it held. A card
         is a surface; colour is reserved for meaning (priority, overdue, labels). -->
    <SolidColorBrush x:Key="Brush.Card.Background" Color="{StaticResource Color.Surface.Card}" />

    <!-- ==== Text ====
         Off-white rather than pure white: 13:1 on a card, without the glare. -->
    <Color x:Key="Color.Text.Primary">#FFF2F2F4</Color>
    <Color x:Key="Color.Text.Secondary">#FFA8A8B2</Color>
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <!-- Metadata: dimmer still, so it recedes behind the title without dropping
         below 4.5:1 on a card. -->
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="#FF8E8E99" />
    <!-- Cards are a neutral surface now, so card text is simply primary text. -->
    <SolidColorBrush x:Key="Brush.Text.OnCard" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Text.Hint" Color="#FF74747E" />

    <!-- ==== Lines ====
         Brush.Divider was Black on grey — invisible. A low-alpha overlay reads on
         every surface in the ramp instead of only one. -->
    <SolidColorBrush x:Key="Brush.Divider" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="Brush.Border" Color="#FF3A3A42" />
    <SolidColorBrush x:Key="Brush.Card.Border" Color="#FF33333B" />

    <!-- ==== Accent ====
         Two of them: the fill carries white text at 5.8:1, which a brighter blue
         cannot, while hairlines and focus rings need the brighter one to register
         against a dark canvas. -->
    <Color x:Key="Color.Accent">#FF3B6FE0</Color>
    <Color x:Key="Color.Accent.Strong">#FF7BA5FF</Color>
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Accent.Strong" Color="{StaticResource Color.Accent.Strong}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#FF4A7CE8" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#FF2F5BC4" />

    <!-- Danger as a fill takes white text; danger as text needs to be light itself. -->
    <SolidColorBrush x:Key="Brush.Danger" Color="#FFC0392B" />
    <SolidColorBrush x:Key="Brush.Danger.Text" Color="#FFFF8A80" />

    <!-- Priority edges: non-text, all above 4.5:1 against a card. -->
    <SolidColorBrush x:Key="Brush.Priority.Low" Color="#FF4CAF50" />
    <SolidColorBrush x:Key="Brush.Priority.Medium" Color="#FFFFA726" />
    <SolidColorBrush x:Key="Brush.Priority.High" Color="#FFFF5252" />

    <!-- ==== Interaction ====
         Translucent layers rather than fixed greys, so one set of states works on
         every surface in the ramp. -->
    <SolidColorBrush x:Key="Brush.State.Hover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.State.Pressed" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="Brush.State.Selected" Color="#333B6FE0" />
    <!-- There was no focus ring at all: keyboard users had nothing to follow. -->
    <SolidColorBrush x:Key="Brush.Focus.Visual" Color="{StaticResource Color.Accent.Strong}" />

    <SolidColorBrush x:Key="Brush.Chip.Background" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Brush.Chip.Border" Color="#26FFFFFF" />

    <!-- Flat buttons (title bar, toolbar) -->
    <SolidColorBrush x:Key="Brush.Button.Flat.Background" Color="Transparent" />
    <SolidColorBrush x:Key="Brush.Button.Flat.Hover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.Button.Flat.Pressed" Color="#24FFFFFF" />
    <!-- Destructive hover for the title bar close button: the Windows standard red,
         deliberately not the palette's danger colour. -->
    <SolidColorBrush x:Key="Brush.Button.Close.Hover" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="Brush.Button.Close.Pressed" Color="#FFA82419" />
    <!-- Solid buttons (sidebar items, project items) sit one step above their host. -->
    <SolidColorBrush x:Key="Brush.Button.Solid.Background" Color="#FF26262B" />
    <SolidColorBrush x:Key="Brush.Button.Solid.Hover" Color="#FF303038" />
    <SolidColorBrush x:Key="Brush.Button.Solid.Pressed" Color="#FF393943" />
    <SolidColorBrush x:Key="Brush.Button.Foreground" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Indicator" Color="{StaticResource Color.Accent.Strong}" />

    <SolidColorBrush x:Key="Brush.ScrollBar.Thumb" Color="#FF3C3C45" />

    <SolidColorBrush x:Key="Brush.TextBox.Background" Color="#FF1A1A1E" />
    <SolidColorBrush x:Key="Brush.TextBox.Border" Color="#FF3A3A42" />
    <SolidColorBrush x:Key="Brush.TextBox.Foreground" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.TextBox.Selection" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.TextBox.Border.Hover" Color="#FF4A4A54" />
    <SolidColorBrush x:Key="Brush.TextBox.Border.Focus" Color="{StaticResource Color.Accent.Strong}" />

</ResourceDictionary>
