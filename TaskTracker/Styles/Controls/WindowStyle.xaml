<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="TaskTracker.Styles.Controls.WindowStyleDictionary">

    <Style TargetType="Window" x:Key="WindowStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Grid Background="Transparent">
                        <Border BorderBrush="{DynamicResource Brush.Window.Background}" CornerRadius="11" Background="{DynamicResource Brush.Window.Background}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Height="30">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="auto" />
                                        </Grid.ColumnDefinitions>
                                        <Label Content="TaskTracker" Foreground="{DynamicResource Brush.Text.Primary}" Margin="10,2,0,0" />
                                        <Rectangle Fill="Transparent">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <EventSetter Event="MouseLeftButtonDown" Handler="Rectangle_MouseLeftButtonDown"/>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Style="{DynamicResource TitleButton}" Height="30" Width="30" Command="{Binding MinimizeCommand}">➖</Button>
                                            <Button Style="{DynamicResource TitleButton}" Height="30" Width="30" Command="{Binding MaximizeCommand}" FontSize="18">▢</Button>
                                            <Button Style="{DynamicResource TitleButton}" Height="30" Width="30" Command="{Binding CloseCommand}">✖</Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <AdornerDecorator Grid.Row="1">
                                    <ContentPresenter/>
                                </AdornerDecorator>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
