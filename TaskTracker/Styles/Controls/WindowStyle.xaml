<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Title bar glyphs as geometry rather than emoji: emoji pick up a colour
         font, ignore the theme foreground, and shift baseline between DPI scales. -->
    <Geometry x:Key="Glyph.Minimize">M 0,5 H 10</Geometry>
    <Geometry x:Key="Glyph.Maximize">M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z</Geometry>
    <Geometry x:Key="Glyph.Restore">M 2.5,0.5 H 9.5 V 7.5 M 0.5,2.5 H 7.5 V 9.5 H 0.5 Z</Geometry>
    <Geometry x:Key="Glyph.Close">M 0,0 L 10,10 M 10,0 L 0,10</Geometry>

    <Style x:Key="TitleBarGlyph" TargetType="Path">
        <!-- Follows the owning button's Foreground, so the close button can flip
             the glyph to white against its red hover without retemplating. -->
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style TargetType="Window" x:Key="WindowStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <!-- Squared off deliberately: without AllowsTransparency a
                         rounded Border would expose the window background at the
                         corners. Windows 11 rounds the frame itself. -->
                    <Border x:Name="WindowRoot"
                            Background="{DynamicResource Brush.Window.Background}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Height matches WindowChrome.CaptionHeight on the window,
                                 so this whole strip drags, double-click maximizes, and
                                 right-click opens the system menu — for free. -->
                            <Grid Height="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{TemplateBinding Title}"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" />

                                <!-- IsHitTestVisibleInChrome carves these back out of the
                                     caption area; without it the chrome swallows the clicks. -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Button Style="{DynamicResource TitleButton}" Height="30" Width="46"
                                            Command="{Binding MinimizeCommand}"
                                            AutomationProperties.Name="{DynamicResource WindowMinimize}">
                                        <Path Style="{StaticResource TitleBarGlyph}" Data="{StaticResource Glyph.Minimize}" />
                                    </Button>
                                    <Button Style="{DynamicResource TitleButton}" Height="30" Width="46"
                                            Command="{Binding MaximizeCommand}"
                                            AutomationProperties.Name="{DynamicResource WindowMaximize}">
                                        <Grid>
                                            <Path x:Name="MaximizeGlyph" Style="{StaticResource TitleBarGlyph}" Data="{StaticResource Glyph.Maximize}" />
                                            <Path x:Name="RestoreGlyph" Style="{StaticResource TitleBarGlyph}" Data="{StaticResource Glyph.Restore}" Visibility="Collapsed" />
                                        </Grid>
                                    </Button>
                                    <Button Style="{DynamicResource TitleCloseButton}" Height="30" Width="46"
                                            Command="{Binding CloseCommand}"
                                            AutomationProperties.Name="{DynamicResource WindowClose}">
                                        <Path Style="{StaticResource TitleBarGlyph}" Data="{StaticResource Glyph.Close}" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <AdornerDecorator Grid.Row="1">
                                <ContentPresenter />
                            </AdornerDecorator>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="MaximizeGlyph" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RestoreGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
