<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Icons as geometry, replacing the 32px PNGs in Assets/.
         Two reasons, both visible: a raster icon softens at every scale factor that
         isn't 100%, and it cannot recolour — the PNGs were drawn light, so in the light
         theme they were near-invisible against their own buttons.

         All are filled paths on a 24x24 grid, drawn to be used with Fill bound to the
         owning control's Foreground. Nothing here relies on a stroke, so one Path
         setter renders every icon. -->

    <Geometry x:Key="Icon.Home">M12,3 L21,11 L18.6,11 L18.6,21 L14,21 L14,15 L10,15 L10,21 L5.4,21 L5.4,11 L3,11 Z</Geometry>

    <Geometry x:Key="Icon.Project">M3,5 L9.4,5 L11.6,7.6 L21,7.6 L21,19 L3,19 Z</Geometry>

    <Geometry x:Key="Icon.Add">M11,4 L13,4 L13,11 L20,11 L20,13 L13,13 L13,20 L11,20 L11,13 L4,13 L4,11 L11,11 Z</Geometry>

    <!-- Pencil: body and tip as one quad, the eraser end as a second. Disjoint, so the
         default even-odd fill rule needs no help. -->
    <Geometry x:Key="Icon.Edit">M3,21 L4.2,16.4 L15.6,5 L19,8.4 L7.6,19.8 Z M16.9,3.7 L20.3,7.1 L18.2,9.2 L14.8,5.8 Z</Geometry>

    <Geometry x:Key="Icon.Trash">M9.5,2.5 L14.5,2.5 L15.5,4.5 L20,4.5 L20,6.5 L4,6.5 L4,4.5 L8.5,4.5 Z M5.8,8 L18.2,8 L17.2,21.5 L6.8,21.5 Z</Geometry>

    <!-- Eight-lobe cog with a concentric hole. The hole is a separate subpath inside
         the outer shape, which even-odd punches through without depending on winding
         direction. -->
    <Geometry x:Key="Icon.Settings">M22,12 L18.84,14.83 L19.07,19.07 L14.83,18.84 L12,22 L9.17,18.84 L4.93,19.07 L5.16,14.83 L2,12 L5.16,9.17 L4.93,4.93 L9.17,5.16 L12,2 L14.83,5.16 L19.07,4.93 L18.84,9.17 Z M12,8.4 A3.6,3.6 0 1 0 12,15.6 A3.6,3.6 0 1 0 12,8.4 Z</Geometry>

    <!-- One star geometry for both states: filled for a favourite, the same outline
         stroked for not. -->
    <Geometry x:Key="Icon.Star">M12,2 L14.9,8.6 L22,9.3 L16.6,14 L18.2,21 L12,17.3 L5.8,21 L7.4,14 L2,9.3 L9.1,8.6 Z</Geometry>

    <!-- Small glyphs for icon-only buttons, replacing the ✖ and ＋ characters those
         buttons used to render. Emoji-range characters get substituted by a colour
         emoji font, which ignores the control's Foreground and shifts baseline between
         DPI scales — the same reason the title bar stopped using them. -->
    <Geometry x:Key="Icon.Close">M 5.2,3.8 L 12,10.6 L 18.8,3.8 L 20.2,5.2 L 13.4,12 L 20.2,18.8 L 18.8,20.2 L 12,13.4 L 5.2,20.2 L 3.8,18.8 L 10.6,12 L 3.8,5.2 Z</Geometry>

    <!-- Shared setter for icons inside a templated control, so size and alignment are
         not restated at every use site. -->
    <Style x:Key="GlyphPath" TargetType="Path">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>

    <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
