<Window x:Class="TaskTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskTracker"
        xmlns:controls="clr-namespace:TaskTracker.Controls"
        mc:Ignorable="d"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Title="MainWindow" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen" WindowStyle="None" 
        Background="Transparent">
    <Border Background="#FF383333" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.ColumnSpan="2" Height="30">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <Label Content="TaskTracker" Foreground="White" Margin="10,2,0,0" />
                    <Rectangle Fill="Transparent" MouseLeftButtonDown="Rectangle_MouseLeftButtonDown" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{DynamicResource TitleButton}" Height="30" Width="30" Click="MinimizeButton_Click">➖</Button>
                        <Button Style="{DynamicResource TitleButton}" Height="30" Width="30" Click="MaximizeButton_Click" FontSize="18">▢</Button>
                        <Button Style="{DynamicResource TitleButton}" Height="30" Width="30" Click="CloseButton_Click">✖</Button>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel MinWidth="150" Grid.Row="1">
                <Label FontSize="30" Foreground="white" Margin="10,0,0,10">Projects</Label>

                <controls:ProjectItem GroupName="checkboxes" Image="/Assets/Home-32.png" Margin="5" Height="40">Home</controls:ProjectItem>

                <Rectangle Height="1" Margin="5" Fill="Black"></Rectangle>
            </StackPanel>
            
            <ScrollViewer VerticalScrollBarVisibility="Auto" MinWidth="150" Grid.Row="2" Margin="0,0,0,120">
                <StackPanel>
                    <controls:ProjectItem GroupName="checkboxes" Image="/Assets/Project-32.png" Margin="5" Height="40">Project 1</controls:ProjectItem>
                    <controls:ProjectItem GroupName="checkboxes" Image="/Assets/Project-32.png" Margin="5" Height="40">Project 1</controls:ProjectItem>
                    <controls:ProjectItem GroupName="checkboxes" Image="/Assets/Project-32.png" Margin="5" Height="40">Project 1</controls:ProjectItem>
                    <controls:ProjectItem GroupName="checkboxes" Image="/Assets/Project-32.png" Margin="5" Height="40">Project 1</controls:ProjectItem>
                    <controls:ProjectItem GroupName="checkboxes" Image="/Assets/Project-32.png" Margin="5" Height="40">Project 1</controls:ProjectItem>
                    <controls:ProjectItem GroupName="checkboxes" Image="/Assets/Project-32.png" Margin="5" Height="40">Project 1</controls:ProjectItem>
                    <controls:ProjectItem GroupName="checkboxes" Image="/Assets/Project-32.png" Margin="5" Height="40">Project 1</controls:ProjectItem>
                 
                    </StackPanel>
            </ScrollViewer>
           
            <DockPanel LastChildFill="False" Grid.Row="2">
                <controls:ProjectItem GroupName="checkboxes" Image="/Assets/Settings-32.png" DockPanel.Dock="Bottom" Margin="5" Height="40">Settings</controls:ProjectItem>

                <Rectangle Height="1" Margin="5" Fill="Black" DockPanel.Dock="Bottom"></Rectangle>

                <controls:SideBarItem Image="/Assets/Add-32.png" DockPanel.Dock="Bottom" Margin="5" Height="40">Add Project</controls:SideBarItem>
            </DockPanel>

            <Border Grid.Column="1" Grid.Row="1" CornerRadius="10" Background="#FF1D1B1B" Grid.RowSpan="3">
            
            </Border>
        </Grid>
    </Border>
</Window>
