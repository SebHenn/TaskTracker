<UserControl x:Class="TaskTracker.Views.Pages.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskTracker.Views.Pages" 
             xmlns:controls="clr-namespace:TaskTracker.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Name}" />
            <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Description}"
                       TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Grid.RowSpan="3" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Due tasks dashboard -->
                <StackPanel Visibility="{Binding HasDueTasks, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}">
                    <StackPanel.Resources>
                        <DataTemplate x:Key="DueTaskRow">
                            <Border Padding="10,6" Margin="0,0,0,4" MinWidth="360" MaxWidth="560" Cursor="Hand"
                                    CornerRadius="{DynamicResource Radius.Card}"
                                    Background="{DynamicResource Brush.Card.Background}"
                                    BorderThickness="1"
                                    AutomationProperties.Name="{Binding Task.Title}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Card.Border}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Strong}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick"
                                                  Command="{Binding DataContext.DueTaskClickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" />
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding Task.Title}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Project.Name}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <!-- The date sits right-aligned in its own column so a long
                                         title can never push it out of view. -->
                                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}"
                                               Text="{Binding Task.DueDate, StringFormat={}{0:d}}"
                                               VerticalAlignment="Center" Margin="12,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </StackPanel.Resources>

                    <TextBlock Style="{StaticResource Text.Subtitle}" Text="{DynamicResource OverdueSection}"
                               Foreground="{DynamicResource Brush.Danger.Text}" Margin="0,20,0,8"
                               Visibility="{Binding OverdueTasks.Count, Converter={StaticResource CountToVisibilityConverter}}" />
                    <ItemsControl ItemsSource="{Binding OverdueTasks}" ItemTemplate="{StaticResource DueTaskRow}" HorizontalAlignment="Left" />

                    <TextBlock Style="{StaticResource Text.Subtitle}" Text="{DynamicResource DueTodaySection}" Margin="0,16,0,8"
                               Visibility="{Binding DueTodayTasks.Count, Converter={StaticResource CountToVisibilityConverter}}" />
                    <ItemsControl ItemsSource="{Binding DueTodayTasks}" ItemTemplate="{StaticResource DueTaskRow}" HorizontalAlignment="Left" />

                    <TextBlock Style="{StaticResource Text.Subtitle}" Text="{DynamicResource DueThisWeekSection}" Margin="0,16,0,8"
                               Visibility="{Binding DueThisWeekTasks.Count, Converter={StaticResource CountToVisibilityConverter}}" />
                    <ItemsControl ItemsSource="{Binding DueThisWeekTasks}" ItemTemplate="{StaticResource DueTaskRow}" HorizontalAlignment="Left" />
                </StackPanel>

                <!-- Nothing due is worth saying out loud; silence reads as a page that
                     failed to load. -->
                <TextBlock Style="{StaticResource Text.Subtitle}" Text="{DynamicResource NothingDue}"
                           Foreground="{DynamicResource Brush.Text.Hint}" Margin="0,24,0,0"
                           Visibility="{Binding HasDueTasks, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=False}" />

                <TextBlock Style="{StaticResource Text.Subtitle}" Text="{DynamicResource RecentProjects}" Margin="0,28,0,8"
                           Visibility="{Binding RecentProjects.Count, Converter={StaticResource CountToVisibilityConverter}}" />
                <ItemsControl ItemsSource="{Binding RecentProjects}" HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Wraps instead of running off the page once there are a few. -->
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:SideBarItem Icon="{StaticResource Icon.Project}" Margin="0,0,8,8" MinWidth="170"
                                                  Content="{Binding Name}"
                                                  Command="{Binding DataContext.ProjectClickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
