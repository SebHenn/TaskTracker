<UserControl x:Class="TaskTracker.Views.Pages.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskTracker.Views.Pages" 
             xmlns:controls="clr-namespace:TaskTracker.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <Label Content="{Binding Name}" FontSize="30" Foreground="{DynamicResource Brush.Text.Primary}"/>
            <TextBlock Text="{Binding Description}" FontSize="16" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,10,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Grid.RowSpan="3" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Due tasks dashboard -->
                <StackPanel Visibility="{Binding HasDueTasks, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}">
                    <StackPanel.Resources>
                        <DataTemplate x:Key="DueTaskRow">
                            <Border Margin="3,2" Padding="8,5" CornerRadius="3" Background="{DynamicResource Brush.Card.Background}" Cursor="Hand" MaxWidth="500">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick"
                                                  Command="{Binding DataContext.DueTaskClickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" />
                                </Border.InputBindings>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Project.Name}" FontSize="12" Foreground="{DynamicResource Brush.Text.OnCard}" Opacity="0.8" VerticalAlignment="Center" />
                                    <TextBlock Text=" ▸ " FontSize="12" Foreground="{DynamicResource Brush.Text.OnCard}" Opacity="0.8" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Task.Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.OnCard}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Task.DueDate, StringFormat={}  📅 {0:d}}" FontSize="11" Foreground="{DynamicResource Brush.Text.OnCard}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </StackPanel.Resources>

                    <Label Content="{DynamicResource OverdueSection}" FontSize="18" Foreground="{DynamicResource Brush.Danger}" Margin="0,15,0,0"
                           Visibility="{Binding OverdueTasks.Count, Converter={StaticResource CountToVisibilityConverter}}" />
                    <ItemsControl ItemsSource="{Binding OverdueTasks}" ItemTemplate="{StaticResource DueTaskRow}" HorizontalAlignment="Left" Margin="10,0" />

                    <Label Content="{DynamicResource DueTodaySection}" FontSize="18" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,10,0,0"
                           Visibility="{Binding DueTodayTasks.Count, Converter={StaticResource CountToVisibilityConverter}}" />
                    <ItemsControl ItemsSource="{Binding DueTodayTasks}" ItemTemplate="{StaticResource DueTaskRow}" HorizontalAlignment="Left" Margin="10,0" />

                    <Label Content="{DynamicResource DueThisWeekSection}" FontSize="18" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,10,0,0"
                           Visibility="{Binding DueThisWeekTasks.Count, Converter={StaticResource CountToVisibilityConverter}}" />
                    <ItemsControl ItemsSource="{Binding DueThisWeekTasks}" ItemTemplate="{StaticResource DueTaskRow}" HorizontalAlignment="Left" Margin="10,0" />
                </StackPanel>

                <Label HorizontalAlignment="Center" Content="{DynamicResource RecentProjects}" FontSize="24" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,20,0,10"/>
                <ItemsControl ItemsSource="{Binding RecentProjects}" HorizontalAlignment="Center">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:SideBarItem Image="/Assets/Project-32.png" Margin="10" Height="35" Content="{Binding Name}" Command="{Binding DataContext.ProjectClickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"></controls:SideBarItem>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
