<UserControl x:Class="TaskTracker.Views.Pages.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TaskTracker.Views.Pages"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource Text.Title}" Text="{DynamicResource SearchResults}" />
            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,4,0,12">
                <Run Text="{Binding ResultCount, Mode=OneWay}" /> <Run Text="{DynamicResource ResultsFor}" /> "<Run Text="{Binding Query, Mode=OneWay}" />"
            </TextBlock>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="0,0,0,6" Cursor="Hand" MaxWidth="720"
                                HorizontalAlignment="Left"
                                CornerRadius="{DynamicResource Radius.Card}"
                                Background="{DynamicResource Brush.Card.Background}"
                                BorderThickness="1"
                                AutomationProperties.Name="{Binding Task.Title}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Card.Border}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Strong}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftClick"
                                              Command="{Binding DataContext.ResultClickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding}" />
                            </Border.InputBindings>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding Task.Title}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Style="{StaticResource TaskChip}" Margin="8,0,0,0"
                                            Visibility="{Binding Task.IsDone, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}">
                                        <TextBlock Style="{StaticResource TaskChipText}" Text="{DynamicResource Done}" />
                                    </Border>
                                </StackPanel>
                                <!-- Which project a hit came from is the point of a global
                                     search, so it is stated plainly rather than run into the
                                     title behind a separator glyph. -->
                                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Project.Name}" Margin="0,2,0,0" />
                                <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Task.Description}"
                                           TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="1" Style="{StaticResource Text.Subtitle}" Text="{DynamicResource NoSearchResults}"
                   Foreground="{DynamicResource Brush.Text.Hint}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="420"
                   Visibility="{Binding ResultCount, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Empty}" />
    </Grid>
</UserControl>
