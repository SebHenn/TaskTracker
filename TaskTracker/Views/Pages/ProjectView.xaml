<UserControl x:Class="TaskTracker.Views.Pages.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TaskTracker.Views.Pages"
             xmlns:controls="clr-namespace:TaskTracker.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseTaskDetailCommand}" />
    </UserControl.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.ColumnSpan="2">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="14" Height="14" Margin="5,0,2,0" VerticalAlignment="Center"
                         Fill="{Binding CurrentProject.Color, Converter={StaticResource ColorStringToBrushConverter}}" />
                <Label Content="{Binding CurrentProject.Name}" FontSize="30" Foreground="{DynamicResource Brush.Text.Primary}"/>
                <Border Style="{StaticResource TaskChip}" Visibility="{Binding CurrentProject.IsArchived, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}">
                    <TextBlock Style="{StaticResource TaskChipText}" Text="{DynamicResource Archived}" Foreground="{DynamicResource Brush.Text.Primary}" />
                </Border>
            </StackPanel>
            <TextBlock Text="{Binding CurrentProject.Description}" FontSize="16" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,10,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Margin="10" Orientation="Horizontal">
            <TextBlock Text="{Binding LastSyncedText}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"
                       Visibility="{Binding IsGitHubLinked, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}" />
            <Button Height="30" Padding="8,0" Command="{Binding SyncGitHubCommand}" Background="{DynamicResource Brush.Accent}" Foreground="White"
                    Content="{DynamicResource Sync}" ToolTip="{DynamicResource Sync}" Margin="0,0,10,0"
                    Visibility="{Binding IsGitHubLinked, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource WindowButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSyncing}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Height="30" Padding="8,0" Style="{DynamicResource WindowButton}" Command="{Binding LinkGitHubCommand}" Background="{DynamicResource Brush.Chip.Background}" Foreground="{DynamicResource Brush.Text.Primary}"
                    Content="{DynamicResource LinkToGitHub}" Margin="0,0,10,0" />
            <Button Height="30" Width="30" Style="{DynamicResource WindowButton}" Command="{Binding FavProjectCommand}" Background="White" ToolTip="{DynamicResource TooltipFavourite}">
                <Image Margin="2" Source="{Binding FavImage}" />
            </Button>
            <Button Margin="10,0,0,0" Height="30" Width="30" Style="{DynamicResource WindowButton}" Command="{Binding ChangeProjectCommand}" Background="{DynamicResource Brush.Accent}" ToolTip="{DynamicResource TooltipEditProject}">
                <Image Margin="2" Source="/Assets/Edit-32.png" />
            </Button>
            <Button Margin="10,0,0,0" Height="30" Padding="8,0" Style="{DynamicResource WindowButton}" Command="{Binding EditColumnsCommand}" Background="{DynamicResource Brush.Chip.Background}" Foreground="{DynamicResource Brush.Text.Primary}" Content="{DynamicResource EditColumns}" />
            <Button Margin="10,0,0,0" Height="30" Padding="8,0" Style="{DynamicResource WindowButton}" Command="{Binding ArchiveProjectCommand}" Background="{DynamicResource Brush.Chip.Background}" Foreground="{DynamicResource Brush.Text.Primary}" Content="{Binding ArchiveButtonText}" ToolTip="{DynamicResource TooltipArchiveProject}" />
            <Button Margin="10,0,0,0" Height="30" Width="30" Style="{DynamicResource WindowButton}" Command="{Binding DeleteProjectCommand}" Background="{DynamicResource Brush.Danger}" ToolTip="{DynamicResource TooltipDeleteProject}">
                <Image Margin="2" Source="/Assets/Trash-32.png" />
            </Button>
        </StackPanel>

        <!-- Statistics -->
        <Expander Grid.Row="1" Grid.ColumnSpan="3" Margin="10,5" Foreground="{DynamicResource Brush.Text.Primary}">
            <Expander.Header>
                <TextBlock Text="{DynamicResource Statistics}" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}" />
            </Expander.Header>
            <StackPanel Orientation="Horizontal" Margin="10,5">
                <StackPanel Margin="0,0,30,0">
                    <TextBlock Foreground="{DynamicResource Brush.Text.Primary}" FontSize="24" HorizontalAlignment="Center" Text="{Binding Stats.OpenCount}" />
                    <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="{DynamicResource Open}" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Margin="0,0,30,0">
                    <TextBlock Foreground="{DynamicResource Brush.Text.Primary}" FontSize="24" HorizontalAlignment="Center" Text="{Binding Stats.DoneCount}" />
                    <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="{DynamicResource Done}" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Margin="0,0,30,0">
                    <TextBlock Foreground="{DynamicResource Brush.Text.Primary}" FontSize="24" HorizontalAlignment="Center" Text="{Binding Stats.OverdueCount}" />
                    <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="{DynamicResource Overdue}" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Margin="0,0,40,0">
                    <TextBlock Foreground="{DynamicResource Brush.Text.Primary}" FontSize="24" HorizontalAlignment="Center" Text="{Binding Stats.CompletionPercent, StringFormat={}{0:0}%}" />
                    <TextBlock Foreground="{DynamicResource Brush.Text.Secondary}" Text="{DynamicResource Complete}" HorizontalAlignment="Center" />
                </StackPanel>
                <!-- Done-per-week bars, oldest to newest -->
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding WeekBars}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="3,0" VerticalAlignment="Bottom" ToolTip="{Binding Tooltip}">
                                    <TextBlock Text="{Binding Count}" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    <Rectangle Width="18" Height="{Binding Height}" Fill="{DynamicResource Brush.Accent}" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{DynamicResource TasksCompletedPerWeek}" FontSize="10" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                </StackPanel>
            </StackPanel>
        </Expander>

        <!-- Label filter -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="10,0,10,5"
                    Visibility="{Binding HasLabels, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}">
            <Label Content="{DynamicResource FilterByLabel}" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
            <ComboBox MinWidth="120" VerticalAlignment="Center"
                      ItemsSource="{Binding AvailableLabels}"
                      SelectedItem="{Binding SelectedLabelFilter, Mode=TwoWay}" />
        </StackPanel>

        <!-- Task detail panel (right side, visible when a task is selected) -->
        <Border Grid.Column="2" Grid.Row="3" Grid.RowSpan="2" Width="320" Margin="5,10,10,10" Padding="12"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="5"
                Background="{DynamicResource Brush.Content.Background}" Panel.ZIndex="1"
                Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <controls:CustomTextBox Height="30" FontWeight="Bold" Text="{Binding SelectedTask.Title, Mode=TwoWay}" />
                        <Button Grid.Column="1" Style="{DynamicResource TitleButton}" Width="26" Height="26" Command="{Binding CloseTaskDetailCommand}">✖</Button>
                    </Grid>

                    <Label Margin="0,8,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" Content="{DynamicResource TaskDescription}" />
                    <TextBox MinLines="5" MaxLines="12" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Text="{Binding SelectedTask.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Label Foreground="{DynamicResource Brush.Text.Secondary}" Content="{DynamicResource DueDate}" />
                            <DatePicker SelectedDate="{Binding SelectedTask.DueDate, Mode=TwoWay}" Height="28" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Foreground="{DynamicResource Brush.Text.Secondary}" Content="{DynamicResource Priority}" />
                            <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding SelectedTask.Priority, Mode=TwoWay}" Height="28" />
                        </StackPanel>
                    </Grid>

                    <Label Margin="0,8,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" Content="{DynamicResource LabelsCommaSeparated}" />
                    <controls:CustomTextBox Height="28" Text="{Binding SelectedTaskLabelsText, Mode=TwoWay}" />

                    <!-- Recurrence -->
                    <Label Margin="0,8,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" Content="{DynamicResource RepeatLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="110" Height="26" ItemsSource="{Binding RecurrenceOptions}"
                                  SelectedItem="{Binding SelectedTask.Recurrence, Mode=TwoWay}" />
                        <Label Margin="8,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" Content="{DynamicResource Every}" />
                        <TextBox Width="36" Height="24" VerticalContentAlignment="Center"
                                 Text="{Binding SelectedTask.RecurrenceInterval, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- Checklist -->
                    <Label Margin="0,10,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" Content="{DynamicResource Checklist}" />
                    <ItemsControl ItemsSource="{Binding SelectedTask.SubTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="6,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Text.Primary}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                        <Setter Property="Opacity" Value="0.6" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Grid.Column="2" Style="{DynamicResource TitleButton}" Width="22" Height="22" FontSize="10"
                                            Command="{Binding DataContext.DeleteSubTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">✖</Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <controls:CustomTextBox Height="26" Text="{Binding NewSubTaskText, Mode=TwoWay}" Hint="{DynamicResource AddSubTaskHint}" />
                        <Button Grid.Column="1" Style="{DynamicResource TitleButton}" Width="26" Height="26" Command="{Binding AddSubTaskCommand}">＋</Button>
                    </Grid>

                    <!-- Time tracking -->
                    <Label Margin="0,8,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" Content="{DynamicResource TimeTracked}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding TrackedTimeText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,10,0" />
                        <Button Padding="10,3" Command="{Binding ToggleTimerCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource WindowButton}">
                                    <Setter Property="Content" Value="{DynamicResource StartTimer}" />
                                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTimerRunning}" Value="True">
                                            <Setter Property="Content" Value="{DynamicResource StopTimer}" />
                                            <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Activity journal -->
                    <Label Margin="0,10,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" Content="{DynamicResource ActivityLabel}" />
                    <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <controls:CustomTextBox Height="26" Text="{Binding NewActivityText, Mode=TwoWay}" Hint="{DynamicResource AddNoteHint}" />
                        <Button Grid.Column="1" Style="{DynamicResource TitleButton}" Width="26" Height="26" Command="{Binding AddActivityCommand}">＋</Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding SelectedTask.Activity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding AtUtc, StringFormat={}{0:g}}" FontSize="10" Foreground="{DynamicResource Brush.Text.Secondary}" />
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="12" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{DynamicResource TitleButton}" Width="20" Height="20" FontSize="9"
                                            Command="{Binding DataContext.DeleteActivityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">✖</Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Metadata -->
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}">
                            <Run Text="{DynamicResource CreatedLabel}" />: <Run Text="{Binding SelectedTask.CreatedAtUtc, Mode=OneWay, StringFormat={}{0:g}}" />
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}">
                            <Run Text="{DynamicResource CompletedLabel}" />: <Run Text="{Binding SelectedTask.CompletedAtUtc, Mode=OneWay, StringFormat={}{0:g}}" />
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Visibility="{Binding IsGitHubLinked, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}">
                            <Run Text="GitHub" />: <Run Text="{Binding SelectedTask.GitHubIssueNumber, Mode=OneWay, StringFormat={}#{0}}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Board lanes, one per column.
             Named and drop-enabled as a whole: it hosts the drag ghost in its adorner
             layer, and its own DragOver — reached only through the gutters between
             lanes, since a lane handles its own — is how "dropped outside a column"
             is detected. Transparent rather than unpainted so it hit-tests at all. -->
        <ItemsControl x:Name="BoardRoot" Grid.ColumnSpan="2" Grid.Row="3" Margin="10" ItemsSource="{Binding Lanes}"
                      Background="Transparent" AllowDrop="True" DragOver="OnDragOverBoard">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- The whole lane accepts drops, header included, so a drop near the
                         top of a column is not silently rejected. -->
                    <Grid Background="Transparent" AllowDrop="True"
                          Drop="OnDropLane" DragOver="OnDragOverLane" Margin="0,0,5,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="{Binding Column.Name}" FontSize="20" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding CountText}" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverWip}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <Border Grid.Row="1" BorderThickness="1" CornerRadius="5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <!-- Which column a card is about to land in. The border
                                             thickness stays put so the cards inside don't reflow. -->
                                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                            <Setter Property="Background" Value="{DynamicResource Brush.Chip.Background}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <!-- ListBox rather than ItemsControl: it virtualizes, and it brings
                                 the focus and selection model that keyboard moves and bulk
                                 actions build on. Its own ScrollViewer replaces the wrapper that
                                 used to be here — an ItemsControl nested in a ScrollViewer is
                                 given infinite height, which silently defeats virtualization. -->
                            <ListBox ItemsSource="{Binding Tasks}"
                                     ItemTemplate="{DynamicResource TaskCardTemplate}"
                                     Background="Transparent" BorderThickness="0"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <!-- Bare ContentPresenter: the card template already
                                             draws everything, and the stock ListBoxItem chrome
                                             would paint a selection block behind it. -->
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnTaskPreviewMouseLeftButtonDown" />
                                        <EventSetter Event="PreviewMouseMove" Handler="OnTaskPreviewMouseMove" />
                                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnTaskPreviewMouseLeftButtonUp" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal">
            <controls:SideBarItem Command="{Binding NewTaskClickCommand}" Image="/Assets/Add-32.png" Margin="5" Height="40" Content="{DynamicResource AddTask}"></controls:SideBarItem>
            <!-- Undo bar shown briefly after a task deletion -->
            <Border VerticalAlignment="Center" Margin="15,0" Padding="10,5" CornerRadius="4" Background="{DynamicResource Brush.Chip.Background}"
                    Visibility="{Binding IsUndoVisible, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding UndoText}" Foreground="{DynamicResource Brush.Text.Primary}" VerticalAlignment="Center" />
                    <Button Style="{DynamicResource TitleButton}" Margin="10,0,0,0" Padding="6,2" FontWeight="Bold"
                            Foreground="{DynamicResource Brush.Accent}" Command="{Binding UndoDeleteCommand}" Content="{DynamicResource Undo}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
