<UserControl x:Class="TaskTracker.Views.Pages.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskTracker.Views.Pages"
             xmlns:controls="clr-namespace:TaskTracker.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        
        <StackPanel Grid.ColumnSpan="2">
            <Label Content="{Binding CurrentProject.Name}" FontSize="30" Foreground="White"/>
            <TextBlock Text="{Binding CurrentProject.Description}" FontSize="16" Foreground="LightGray" Margin="0,10,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Margin="10" Orientation="Horizontal">
            <Button Height="30" Width="30" Style="{DynamicResource WindowButton}" Command="{Binding ChangeProjectCommand}" Background="#FF1D45BF">
                <Image Margin="2" Source="/Assets/Edit-32.png"></Image>
            </Button>
            <Button Margin="10,0,0,0" Height="30" Width="30" Style="{DynamicResource WindowButton}" Command="{Binding DeleteProjectCommand}" Background="#FFBF1D1D">
                <Image Margin="2" Source="/Assets/Trash-32.png"></Image>
            </Button>
        </StackPanel>
        
        <Grid Grid.ColumnSpan="2" Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Not Done Tasks -->
            <Grid Grid.Column="0" Drop="OnDropNotDone" DragOver="OnDragOver" Margin="0,0,5,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Label Content="In Progress" FontSize="20" Foreground="White" Margin="0,0,0,5"/>
                <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" AllowDrop="True" Background="Transparent">
                    <ItemsControl ItemsSource="{Binding NotDoneTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="CadetBlue" Margin="5" Padding="10" CornerRadius="3" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="Black" Opacity="0.3" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="White" />
                                        <TextBlock Text="{Binding Description}" FontSize="14" Foreground="White" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <!-- Mark as Done Command -->
                                            <MenuItem Header="Mark as Done" 
                                              Command="{Binding PlacementTarget.Tag.MarkAsDoneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                              CommandParameter="{Binding}" />

                                            <!-- Edit Task Command -->
                                            <MenuItem Header="Edit Task" 
                                              Command="{Binding PlacementTarget.Tag.EditTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                              CommandParameter="{Binding}" />

                                            <!-- Delete Task Command -->
                                            <MenuItem Header="Delete Task" 
                                              Command="{Binding PlacementTarget.Tag.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                              CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnTaskPreviewMouseLeftButtonDown" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </Border>
            </Grid>

            <!-- Done Tasks -->
            <Grid Grid.Column="1" Drop="OnDropDone" DragOver="OnDragOver" Margin="0,0,5,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Label Content="Done" FontSize="20" Foreground="White" Margin="0,0,0,5"/>
                <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" AllowDrop="True" Background="Transparent">
                    <ItemsControl ItemsSource="{Binding DoneTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="CadetBlue" Margin="5" Padding="10" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CornerRadius="3">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="Black" Opacity="0.3" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="White" />
                                        <TextBlock Text="{Binding Description}" FontSize="14" Foreground="White" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <!-- Mark as Done Command -->
                                            <MenuItem Header="Mark as Done" 
                                              Command="{Binding PlacementTarget.Tag.MarkAsDoneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                              CommandParameter="{Binding}" />

                                            <!-- Edit Task Command -->
                                            <MenuItem Header="Edit Task" 
                                              Command="{Binding PlacementTarget.Tag.EditTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                              CommandParameter="{Binding}" />

                                            <!-- Delete Task Command -->
                                            <MenuItem Header="Delete Task" 
                                              Command="{Binding PlacementTarget.Tag.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                              CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnTaskPreviewMouseLeftButtonDown" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </Border>
            </Grid>
        </Grid>
        
        <controls:SideBarItem Grid.Row="2" Command="{Binding NewTaskClickCommand}" Image="/Assets/Add-32.png" Margin="5" Height="40">Add Task</controls:SideBarItem>
    </Grid>
</UserControl>
