<UserControl x:Class="TaskTracker.Views.Pages.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TaskTracker.Views.Pages"
             xmlns:controls="clr-namespace:TaskTracker.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseTaskDetailCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <!-- DisplayMemberPath styles what is drawn but not what is announced: without
             this the container falls back to the item's ToString and a screen reader
             reads "DueFilterOption { Value = Overdue, Text = Overdue }". -->
        <Style x:Key="FilterOption" TargetType="ComboBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.ColumnSpan="2" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center"
                         Fill="{Binding CurrentProject.Color, Converter={StaticResource ColorStringToBrushConverter}}" />
                <TextBlock Style="{StaticResource Text.Title}" Text="{Binding CurrentProject.Name}" />
                <Border Style="{StaticResource TaskChip}" VerticalAlignment="Center" Margin="8,4,0,0"
                        Visibility="{Binding CurrentProject.IsArchived, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}">
                    <TextBlock Style="{StaticResource TaskChipText}" Text="{DynamicResource Archived}" />
                </Border>
            </StackPanel>
            <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding CurrentProject.Description}"
                       TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Project actions. One accent button (the primary action when GitHub is
             linked) and the rest neutral or subtle, so the toolbar has a single focal
             point instead of six competing coloured boxes. -->
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
            <!-- Doubles as the failure line: a background sync that fails says so here
                 rather than only in the log, where nobody looks. Trimmed to one line with
                 the full reason on hover, so a long exception message cannot push the
                 toolbar buttons off the edge. -->
            <TextBlock Text="{Binding LastSyncedText}" ToolTip="{Binding LastSyncedText}"
                       VerticalAlignment="Center" Margin="0,0,8,0"
                       MaxWidth="240" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding IsGitHubLinked, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSyncError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger.Text}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Command="{Binding SyncGitHubCommand}" Content="{DynamicResource Sync}"
                    ToolTip="{DynamicResource Sync}" Margin="{DynamicResource Gap.Column}"
                    Visibility="{Binding IsGitHubLinked, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSyncing}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Style="{DynamicResource SubtleButton}" Command="{Binding LinkGitHubCommand}"
                    Content="{DynamicResource LinkToGitHub}" Margin="{DynamicResource Gap.Column}" />
            <Button Style="{DynamicResource SubtleButton}" Command="{Binding EditColumnsCommand}"
                    Content="{DynamicResource EditColumns}" Margin="{DynamicResource Gap.Column}" />
            <Button Style="{DynamicResource SubtleButton}" Command="{Binding OpenTrashCommand}"
                    Content="{DynamicResource OpenTrash}" ToolTip="{DynamicResource TrashTitle}"
                    Margin="{DynamicResource Gap.Column}" />
            <Button Style="{DynamicResource SubtleButton}" Command="{Binding ArchiveProjectCommand}"
                    Content="{Binding ArchiveButtonText}" ToolTip="{DynamicResource TooltipArchiveProject}"
                    Margin="{DynamicResource Gap.Column}" />

            <!-- Density: a board-level view preference, so it belongs on the board
                 rather than buried in Settings. -->
            <Button Command="{Binding ToggleDensityCommand}" Content="{DynamicResource CompactCardsSetting}"
                    Margin="{DynamicResource Gap.Column}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SubtleButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Strong}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Style="{DynamicResource SubtleButton}" Width="34" Height="32" Padding="0"
                    Command="{Binding FavProjectCommand}" ToolTip="{DynamicResource TooltipFavourite}"
                    AutomationProperties.Name="{DynamicResource TooltipFavourite}"
                    Margin="{DynamicResource Gap.ColumnTight}">
                <!-- One geometry, two states: filled when favourite, outlined when not. -->
                <Path Data="{StaticResource Icon.Star}" Width="17" Height="17" Stretch="Uniform" StrokeThickness="1.5">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Fill" Value="Transparent" />
                            <Setter Property="Stroke" Value="{DynamicResource Brush.Text.Secondary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentProject.IsFavourite}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Priority.Medium}" />
                                    <Setter Property="Stroke" Value="{DynamicResource Brush.Priority.Medium}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Button>
            <Button Style="{DynamicResource SubtleButton}" Width="34" Height="32" Padding="0"
                    Command="{Binding ChangeProjectCommand}" ToolTip="{DynamicResource TooltipEditProject}"
                    AutomationProperties.Name="{DynamicResource TooltipEditProject}"
                    Margin="{DynamicResource Gap.ColumnTight}">
                <Path Data="{StaticResource Icon.Edit}" Width="17" Height="17" Stretch="Uniform"
                      Fill="{DynamicResource Brush.Text.Secondary}" />
            </Button>
            <!-- Destructive, and the only red on the page. -->
            <Button Style="{DynamicResource SubtleButton}" Width="34" Height="32" Padding="0"
                    Command="{Binding DeleteProjectCommand}" ToolTip="{DynamicResource TooltipDeleteProject}"
                    AutomationProperties.Name="{DynamicResource TooltipDeleteProject}">
                <Path Data="{StaticResource Icon.Trash}" Width="17" Height="17" Stretch="Uniform"
                      Fill="{DynamicResource Brush.Danger.Text}" />
            </Button>
        </StackPanel>

        <!-- Statistics -->
        <Expander Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0" Foreground="{DynamicResource Brush.Text.Primary}">
            <Expander.Header>
                <TextBlock Style="{StaticResource Text.Body}" Text="{DynamicResource Statistics}" />
            </Expander.Header>
            <StackPanel Orientation="Horizontal" Margin="4,12,0,4">
                <StackPanel Margin="0,0,32,0">
                    <TextBlock Style="{StaticResource Text.Metric}" Text="{Binding Stats.OpenCount}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{DynamicResource Open}" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Margin="0,0,32,0">
                    <TextBlock Style="{StaticResource Text.Metric}" Text="{Binding Stats.DoneCount}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{DynamicResource Done}" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Margin="0,0,32,0">
                    <!-- The one metric that turns red when it isn't zero. -->
                    <TextBlock Text="{Binding Stats.OverdueCount}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Metric}">
                                <!-- Default is the alarming colour and the trigger stands it
                                     down, because a DataTrigger can only match equality —
                                     "any non-zero" has to be the unmatched case. -->
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger.Text}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Stats.OverdueCount}" Value="0">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{DynamicResource Overdue}" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Margin="0,0,40,0">
                    <TextBlock Style="{StaticResource Text.Metric}" Text="{Binding Stats.CompletionPercent, StringFormat={}{0:0}%}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{DynamicResource Complete}" HorizontalAlignment="Center" />
                </StackPanel>
                <!-- Done-per-week bars, oldest to newest -->
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding WeekBars}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="3,0" VerticalAlignment="Bottom" ToolTip="{Binding Tooltip}">
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Count}" HorizontalAlignment="Center" />
                                    <Rectangle Width="18" Height="{Binding Height}" Fill="{DynamicResource Brush.Accent}" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{DynamicResource TasksCompletedPerWeek}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
        </Expander>

        <!-- Filters. Due and priority always apply; the label box appears only once the
             project actually uses labels, since an empty dropdown is just noise. -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="10,0,10,5">
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding HasLabels, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}">
                <Label Content="{DynamicResource FilterByLabel}" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                <ComboBox MinWidth="120" VerticalAlignment="Center" Margin="0,0,14,0"
                          AutomationProperties.Name="{DynamicResource FilterByLabel}"
                          ItemsSource="{Binding AvailableLabels}"
                          SelectedItem="{Binding SelectedLabelFilter, Mode=TwoWay}" />
            </StackPanel>

            <Label Content="{DynamicResource FilterByDue}" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
            <ComboBox MinWidth="130" VerticalAlignment="Center" Margin="0,0,14,0"
                      AutomationProperties.Name="{DynamicResource FilterByDue}"
                      ItemsSource="{Binding DueFilters}" DisplayMemberPath="Text"
                      ItemContainerStyle="{StaticResource FilterOption}"
                      SelectedItem="{Binding SelectedDueFilter, Mode=TwoWay}" />

            <Label Content="{DynamicResource FilterByPriority}" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
            <ComboBox MinWidth="100" VerticalAlignment="Center"
                      AutomationProperties.Name="{DynamicResource FilterByPriority}"
                      ItemsSource="{Binding PriorityFilters}" DisplayMemberPath="Text"
                      ItemContainerStyle="{StaticResource FilterOption}"
                      SelectedItem="{Binding SelectedPriorityFilter, Mode=TwoWay}" />

            <!-- Only offered when there is something to clear, so the row stays quiet
                 in its normal state. -->
            <Button Style="{DynamicResource SubtleButton}" Command="{Binding ClearFiltersCommand}"
                    Content="{DynamicResource ClearFilters}" Margin="14,0,0,0" VerticalAlignment="Center"
                    Visibility="{Binding IsFilterActive, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}" />
        </StackPanel>

        <!-- Task detail panel (right side, visible when a task is selected) -->
        <Border Grid.Column="2" Grid.Row="3" Grid.RowSpan="2" Width="320" Margin="5,10,10,10" Padding="12"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="5"
                Background="{DynamicResource Brush.Content.Background}" Panel.ZIndex="1"
                Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <controls:CustomTextBox Height="30" FontWeight="Bold" Text="{Binding SelectedTask.Title, Mode=TwoWay}" />
                        <Button Grid.Column="1" Style="{DynamicResource TitleButton}" Width="26" Height="26"
                                Command="{Binding CloseTaskDetailCommand}"
                                ToolTip="{DynamicResource CloseDetails}"
                                AutomationProperties.Name="{DynamicResource CloseDetails}">
                            <Path Style="{DynamicResource GlyphPath}" Data="{DynamicResource Icon.Close}" />
                        </Button>
                    </Grid>

                    <Label Margin="0,8,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" Content="{DynamicResource TaskDescription}" />
                    <TextBox MinLines="5" MaxLines="12" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Text="{Binding SelectedTask.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Label Foreground="{DynamicResource Brush.Text.Secondary}" Content="{DynamicResource DueDate}" />
                            <DatePicker SelectedDate="{Binding SelectedTask.DueDate, Mode=TwoWay}" Height="28" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Foreground="{DynamicResource Brush.Text.Secondary}" Content="{DynamicResource Priority}" />
                            <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding SelectedTask.Priority, Mode=TwoWay}" Height="28" />
                        </StackPanel>
                    </Grid>

                    <Label Margin="0,8,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" Content="{DynamicResource LabelsCommaSeparated}" />
                    <controls:CustomTextBox Height="28" Text="{Binding SelectedTaskLabelsText, Mode=TwoWay}" />

                    <!-- Recurrence -->
                    <Label Margin="0,8,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" Content="{DynamicResource RepeatLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="110" Height="26" ItemsSource="{Binding RecurrenceOptions}"
                                  SelectedItem="{Binding SelectedTask.Recurrence, Mode=TwoWay}" />
                        <Label Margin="8,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" Content="{DynamicResource Every}" />
                        <TextBox Width="36" Height="24" VerticalContentAlignment="Center"
                                 Text="{Binding SelectedTask.RecurrenceInterval, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- Checklist -->
                    <Label Margin="0,10,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" Content="{DynamicResource Checklist}" />
                    <ItemsControl ItemsSource="{Binding SelectedTask.SubTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="6,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Text.Primary}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                        <Setter Property="Opacity" Value="0.6" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Grid.Column="2" Style="{DynamicResource TitleButton}" Width="22" Height="22" FontSize="10"
                                            Command="{Binding DataContext.DeleteSubTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{DynamicResource Remove}">
                                        <Path Style="{DynamicResource GlyphPath}" Width="8" Height="8" Data="{DynamicResource Icon.Close}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <controls:CustomTextBox Height="26" Text="{Binding NewSubTaskText, Mode=TwoWay}" Hint="{DynamicResource AddSubTaskHint}" />
                        <Button Grid.Column="1" Style="{DynamicResource TitleButton}" Width="26" Height="26"
                                Command="{Binding AddSubTaskCommand}"
                                AutomationProperties.Name="{DynamicResource Add}">
                            <Path Style="{DynamicResource GlyphPath}" Data="{DynamicResource Icon.Add}" />
                        </Button>
                    </Grid>

                    <!-- Time tracking -->
                    <Label Margin="0,8,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" Content="{DynamicResource TimeTracked}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding TrackedTimeText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Padding="10,3" Command="{Binding ToggleTimerCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource WindowButton}">
                                    <Setter Property="Content" Value="{DynamicResource StartTimer}" />
                                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTimerRunning}" Value="True">
                                            <Setter Property="Content" Value="{DynamicResource StopTimer}" />
                                            <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Activity journal -->
                    <Label Margin="0,10,0,0" Foreground="{DynamicResource Brush.Text.Secondary}" Content="{DynamicResource ActivityLabel}" />
                    <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <controls:CustomTextBox Height="26" Text="{Binding NewActivityText, Mode=TwoWay}" Hint="{DynamicResource AddNoteHint}" />
                        <Button Grid.Column="1" Style="{DynamicResource TitleButton}" Width="26" Height="26"
                                Command="{Binding AddActivityCommand}"
                                AutomationProperties.Name="{DynamicResource Add}">
                            <Path Style="{DynamicResource GlyphPath}" Data="{DynamicResource Icon.Add}" />
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding SelectedTask.Activity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding AtUtc, StringFormat={}{0:g}}" />
                                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Text}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{DynamicResource TitleButton}" Width="20" Height="20"
                                            Command="{Binding DataContext.DeleteActivityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{DynamicResource Remove}">
                                        <Path Style="{DynamicResource GlyphPath}" Width="8" Height="8" Data="{DynamicResource Icon.Close}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Metadata -->
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource Text.Caption}">
                            <Run Text="{DynamicResource CreatedLabel}" />: <Run Text="{Binding SelectedTask.CreatedAtUtc, Mode=OneWay, StringFormat={}{0:g}}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Text.Caption}">
                            <Run Text="{DynamicResource CompletedLabel}" />: <Run Text="{Binding SelectedTask.CompletedAtUtc, Mode=OneWay, StringFormat={}{0:g}}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Text.Caption}"
                                   Visibility="{Binding IsGitHubLinked, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}">
                            <Run Text="GitHub" />: <Run Text="{Binding SelectedTask.GitHubIssueNumber, Mode=OneWay, StringFormat={}#{0}}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Board lanes, one per column.
             Named and drop-enabled as a whole: it hosts the drag ghost in its adorner
             layer, and its own DragOver — reached only through the gutters between
             lanes, since a lane handles its own — is how "dropped outside a column"
             is detected. Transparent rather than unpainted so it hit-tests at all. -->
        <ItemsControl x:Name="BoardRoot" Grid.ColumnSpan="2" Grid.Row="3" Margin="0,8,0,0" ItemsSource="{Binding Lanes}"
                      AutomationProperties.Name="{Binding CurrentProject.Name}"
                      AutomationProperties.AutomationId="Board"
                      Background="Transparent" AllowDrop="True" DragOver="OnDragOverBoard">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <!-- Without this the generated container falls back to the item's ToString,
                 so a screen reader announces each column as
                 "TaskTracker.ViewModels.Pages.ColumnLaneViewModel". -->
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Column.Name}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- The whole lane accepts drops, header included, so a drop near the
                         top of a column is not silently rejected. -->
                    <Grid Background="Transparent" AllowDrop="True"
                          Drop="OnDropLane" DragOver="OnDragOverLane" Margin="0,0,5,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- Column header: name, count, and whether the WIP limit is blown.
                             BoardColumn has carried the limit all along with nothing
                             surfacing it, so an over-limit column looked like any other. -->
                        <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                            <TextBlock Style="{StaticResource Text.Subtitle}" Text="{Binding Column.Name}"
                                       TextTrimming="CharacterEllipsis" />
                            <Border VerticalAlignment="Center" Margin="8,2,0,0">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource TaskChip}">
                                        <Setter Property="Margin" Value="8,2,0,0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverWip}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                                                <Setter Property="ToolTip" Value="{DynamicResource WipLimitReached}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding CountText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TaskChipText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOverWip}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <Border Grid.Row="1" BorderThickness="1" Padding="6"
                                CornerRadius="{DynamicResource Radius.Panel}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Divider}" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <!-- Which column a card is about to land in. The border
                                             thickness stays put so the cards inside don't reflow. -->
                                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                            <Setter Property="Background" Value="{DynamicResource Brush.Chip.Background}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <!-- ListBox rather than ItemsControl: it virtualizes, and it brings
                                 the focus and selection model that keyboard moves and bulk
                                 actions build on. Its own ScrollViewer replaces the wrapper that
                                 used to be here — an ItemsControl nested in a ScrollViewer is
                                 given infinite height, which silently defeats virtualization. -->
                            <ListBox ItemsSource="{Binding Tasks}"
                                     ItemTemplate="{DynamicResource TaskCardTemplate}"
                                     SelectionMode="Extended"
                                     SelectionChanged="OnLaneSelectionChanged"
                                     Background="Transparent" BorderThickness="0"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     AutomationProperties.Name="{Binding Column.Name}"
                                     AutomationProperties.ItemStatus="{Binding CountText}"
                                     AutomationProperties.AutomationId="BoardLane"
                                     KeyboardNavigation.TabNavigation="Once">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                        <!-- The card template draws the card; the container adds
                                             only the ring, because which card is current is a
                                             property of the selection, not of the task. The stock
                                             ListBoxItem chrome would paint a block behind it. -->
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Grid>
                                                        <ContentPresenter HorizontalAlignment="Stretch" />
                                                        <!-- Bottom margin matches the card's, so the
                                                             ring lands on the card and not the gap
                                                             below it. -->
                                                        <Border x:Name="Ring" Margin="0,0,0,6" BorderThickness="2"
                                                                CornerRadius="{DynamicResource Radius.Card}"
                                                                BorderBrush="{DynamicResource Brush.Focus.Visual}"
                                                                IsHitTestVisible="False" Visibility="Collapsed" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <!-- Selection, not focus: arrow keys move the
                                                             ListBox's selection, and without something
                                                             marking it there is no way to tell which
                                                             card the next keystroke will act on. It
                                                             doubles as showing which card the detail
                                                             drawer is currently displaying. -->
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnTaskPreviewMouseLeftButtonDown" />
                                        <EventSetter Event="PreviewMouseMove" Handler="OnTaskPreviewMouseMove" />
                                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnTaskPreviewMouseLeftButtonUp" />
                                        <EventSetter Event="PreviewKeyDown" Handler="OnTaskPreviewKeyDown" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>

                        <!-- Layered over the lane in the same row rather than nested inside
                             it, so it costs no wrapper and cannot intercept a drop. An
                             empty column previously showed a bare outline with no
                             indication whether it was empty or still loading. -->
                        <TextBlock Grid.Row="1" Style="{StaticResource Text.Caption}"
                                   Text="{DynamicResource EmptyColumn}"
                                   HorizontalAlignment="Center" VerticalAlignment="Top"
                                   Margin="0,18,0,0" IsHitTestVisible="False"
                                   Foreground="{DynamicResource Brush.Text.Hint}"
                                   Visibility="{Binding Tasks.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Empty}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Whole-project empty state: distinct from an empty column, and the one place
             that says what to do next on a brand new project. -->
        <StackPanel Grid.ColumnSpan="2" Grid.Row="3" VerticalAlignment="Center" IsHitTestVisible="False"
                    Visibility="{Binding HasAnyTasks, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=False}">
            <TextBlock Style="{StaticResource Text.Subtitle}" Text="{DynamicResource EmptyBoard}"
                       Foreground="{DynamicResource Brush.Text.Hint}"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />
        </StackPanel>

        <!-- Filtered-empty is a different situation from an empty project and needs
             different wording: the tasks are there, they just don't match. Without this
             a narrow filter looked exactly like a board that had lost its contents.
             Hit-testable, unlike the empty-project state, because the way out is the
             button inside it. -->
        <StackPanel Grid.ColumnSpan="2" Grid.Row="3" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasAnyTasks}" Value="True" />
                                <Condition Binding="{Binding HasVisibleTasks}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Style="{StaticResource Text.Subtitle}" Text="{DynamicResource NoTasksMatchFilter}"
                       Foreground="{DynamicResource Brush.Text.Hint}"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />
            <Button Style="{DynamicResource SubtleButton}" Command="{Binding ClearFiltersCommand}"
                    Content="{DynamicResource ClearFilters}" HorizontalAlignment="Center" Margin="0,12,0,0" />
        </StackPanel>

        <WrapPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,12,0,0">
            <controls:SideBarItem Command="{Binding NewTaskClickCommand}" Icon="{StaticResource Icon.Add}"
                                  MinWidth="130" Content="{DynamicResource AddTask}" />

            <!-- Bulk actions, from two selected cards up. One card selected is just the
                 current card; the bar earns its space once clicking each in turn starts
                 to cost something. The destination columns are buttons rather than a
                 picker because a board has a handful of them and one click beats two. -->
            <Border VerticalAlignment="Center" Margin="16,0" Padding="10,5"
                    CornerRadius="{DynamicResource Radius.Control}"
                    Background="{DynamicResource Brush.Chip.Background}"
                    BorderBrush="{DynamicResource Brush.Accent.Strong}" BorderThickness="1"
                    Visibility="{Binding HasBulkSelection, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.BodyStrong}" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Run Text="{Binding SelectionCount, Mode=OneWay}" /><Run Text=" " /><Run Text="{DynamicResource SelectedCount}" />
                    </TextBlock>

                    <TextBlock Style="{StaticResource Text.Caption}" Text="{DynamicResource MoveSelectedTo}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ItemsControl ItemsSource="{Binding CurrentProject.Columns}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{DynamicResource SubtleButton}" Padding="8,3" Margin="0,0,4,0"
                                        Content="{Binding Name}"
                                        Command="{Binding DataContext.MoveSelectedToColumnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Style="{DynamicResource SubtleButton}" Padding="8,3" Margin="10,0,0,0"
                            Foreground="{DynamicResource Brush.Danger.Text}"
                            Command="{Binding DeleteSelectedCommand}" Content="{DynamicResource DeleteSelected}" />
                    <Button Style="{DynamicResource TitleButton}" Padding="6,3" Margin="6,0,0,0"
                            Command="{Binding ClearSelectionCommand}" Content="{DynamicResource ClearSelection}" />
                </StackPanel>
            </Border>

            <!-- Undo bar shown briefly after a task deletion -->
            <Border VerticalAlignment="Center" Margin="16,0" Padding="10,5"
                    CornerRadius="{DynamicResource Radius.Control}"
                    Background="{DynamicResource Brush.Chip.Background}"
                    BorderBrush="{DynamicResource Brush.Chip.Border}" BorderThickness="1"
                    Visibility="{Binding IsUndoVisible, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding UndoText}" VerticalAlignment="Center" />
                    <Button Style="{DynamicResource TitleButton}" Margin="10,0,0,0" Padding="6,2" FontWeight="Bold"
                            Foreground="{DynamicResource Brush.Accent}" Command="{Binding UndoDeleteCommand}" Content="{DynamicResource Undo}" />
                </StackPanel>
            </Border>
        </WrapPanel>
    </Grid>
</UserControl>
