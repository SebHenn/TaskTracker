<UserControl x:Class="TaskTracker.Views.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TaskTracker.Views.Pages"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="SettingsGroup" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="15" />
            <Setter Property="Margin" Value="0,0,0,15" />
        </Style>
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="600" HorizontalAlignment="Left">
            <Label Content="{DynamicResource Settings}" FontSize="30" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,15" />

            <!-- Appearance -->
            <Border Style="{StaticResource SettingsGroup}">
                <StackPanel>
                    <TextBlock Style="{StaticResource GroupHeader}" Text="{DynamicResource Appearance}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource DarkMode}" />
                        <CheckBox IsChecked="{Binding IsDark, Mode=TwoWay}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Language -->
            <Border Style="{StaticResource SettingsGroup}">
                <StackPanel>
                    <TextBlock Style="{StaticResource GroupHeader}" Text="{DynamicResource Language}" />
                    <ComboBox Width="200" HorizontalAlignment="Left"
                              ItemsSource="{Binding AvailableLanguages}"
                              DisplayMemberPath="NativeName"
                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- GitHub -->
            <Border Style="{StaticResource SettingsGroup}">
                <StackPanel>
                    <TextBlock Style="{StaticResource GroupHeader}" Text="{DynamicResource GitHub}" />
                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource GitHubTokenLabel}" Margin="0,0,0,5" />
                    <StackPanel Orientation="Horizontal">
                        <PasswordBox x:Name="TokenBox" Width="280" Height="28" VerticalContentAlignment="Center" PasswordChanged="TokenBox_PasswordChanged" />
                        <Button Style="{DynamicResource WindowButton}" Padding="8,3" Margin="10,0,0,0" Command="{Binding SaveTokenCommand}" Content="{DynamicResource SaveToken}"></Button>
                        <Button Style="{DynamicResource WindowButton}" Padding="8,3" Margin="10,0,0,0" Command="{Binding ClearTokenCommand}" Content="{DynamicResource ClearToken}"></Button>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SettingLabel}" Margin="0,8,0,0" Text="{Binding TokenStatusText}" />
                    <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap"
                               Text="{DynamicResource TokenPlaintextWarning}"
                               Visibility="{Binding ShowPlaintextWarning, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <CheckBox IsChecked="{Binding AutoSyncEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource SettingLabel}" Margin="8,0,0,0" Text="{DynamicResource AutoSync}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Data -->
            <Border Style="{StaticResource SettingsGroup}">
                <StackPanel>
                    <TextBlock Style="{StaticResource GroupHeader}" Text="{DynamicResource Data}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding DataFolder}" />
                        <Button Style="{DynamicResource WindowButton}" Padding="8,3" Command="{Binding OpenDataFolderCommand}" Content="{DynamicResource OpenFolder}"></Button>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SettingLabel}" Margin="0,8,0,0"
                               Text="{DynamicResource DataFolderHint}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{DynamicResource WindowButton}" Padding="8,3" Command="{Binding ExportJsonCommand}" Content="{DynamicResource ExportJson}" />
                        <Button Style="{DynamicResource WindowButton}" Padding="8,3" Margin="10,0,0,0" Command="{Binding ExportCsvCommand}" Content="{DynamicResource ExportCsv}" />
                        <Button Style="{DynamicResource WindowButton}" Padding="8,3" Margin="10,0,0,0" Command="{Binding ImportJsonCommand}" Content="{DynamicResource ImportJson}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
