<UserControl x:Class="TaskTracker.Views.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TaskTracker.Views.Pages"
             xmlns:controls="clr-namespace:TaskTracker.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="SettingsGroup" TargetType="Border">
            <!-- A raised surface, so each group reads as a panel on the page rather
                 than an outline drawn on it. -->
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Card.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}" />
            <Setter Property="Padding" Value="{DynamicResource Pad.Group}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <!-- Derived from the shared ramp rather than restating sizes: a settings
             heading is a Subtitle and a setting label is Body, the same as everywhere. -->
        <Style x:Key="GroupHeader" TargetType="TextBlock" BasedOn="{StaticResource Text.Subtitle}">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="600" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource Text.Title}" Text="{DynamicResource Settings}" Margin="0,0,0,16" />

            <!-- Appearance -->
            <Border Style="{StaticResource SettingsGroup}">
                <StackPanel>
                    <TextBlock Style="{StaticResource GroupHeader}" Text="{DynamicResource Appearance}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource FollowSystemTheme}" />
                        <CheckBox IsChecked="{Binding FollowSystemTheme, Mode=TwoWay}" VerticalAlignment="Center"
                                  AutomationProperties.Name="{DynamicResource FollowSystemTheme}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource DarkMode}" />
                        <!-- Disabled rather than hidden while following Windows: the box
                             still shows which theme is in effect. -->
                        <CheckBox IsChecked="{Binding IsDark, Mode=TwoWay}" VerticalAlignment="Center"
                                  IsEnabled="{Binding FollowSystemTheme, Converter={StaticResource InverseBoolConverter}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource QuickAddHotkeySetting}" />
                        <CheckBox IsChecked="{Binding QuickAddHotkeyEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource QuickAddHotkeyCombo}" />
                        <controls:CustomTextBox Width="140" Height="26" VerticalAlignment="Center"
                                                IsEnabled="{Binding QuickAddHotkeyEnabled}"
                                                AutomationProperties.Name="{DynamicResource QuickAddHotkeyCombo}"
                                                Text="{Binding QuickAddHotkey, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="{DynamicResource Brush.Danger.Text}" Text="{Binding HotkeyStatusText}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource LaunchOnStartupSetting}" />
                        <CheckBox IsChecked="{Binding LaunchOnStartupEnabled, Mode=TwoWay}" VerticalAlignment="Center"
                                  AutomationProperties.Name="{DynamicResource LaunchOnStartupSetting}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="{DynamicResource LaunchOnStartupHint}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Danger.Text}"
                               Text="{DynamicResource LaunchOnStartupFailed}"
                               Visibility="{Binding ShowStartupFailedWarning, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}" />
                </StackPanel>
            </Border>

            <!-- Language -->
            <Border Style="{StaticResource SettingsGroup}">
                <StackPanel>
                    <TextBlock Style="{StaticResource GroupHeader}" Text="{DynamicResource Language}" />
                    <ComboBox Width="200" HorizontalAlignment="Left"
                              ItemsSource="{Binding AvailableLanguages}"
                              DisplayMemberPath="NativeName"
                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- GitHub -->
            <Border Style="{StaticResource SettingsGroup}">
                <StackPanel>
                    <TextBlock Style="{StaticResource GroupHeader}" Text="{DynamicResource GitHub}" />
                    <TextBlock Style="{StaticResource SettingLabel}" Text="{DynamicResource GitHubTokenLabel}" Margin="0,0,0,5" />
                    <StackPanel Orientation="Horizontal">
                        <PasswordBox x:Name="TokenBox" Width="280" Height="28" VerticalContentAlignment="Center" PasswordChanged="TokenBox_PasswordChanged" />
                        <Button Style="{DynamicResource WindowButton}" Padding="8,3" Margin="10,0,0,0" Command="{Binding SaveTokenCommand}" Content="{DynamicResource SaveToken}"></Button>
                        <Button Style="{DynamicResource WindowButton}" Padding="8,3" Margin="10,0,0,0" Command="{Binding ClearTokenCommand}" Content="{DynamicResource ClearToken}"></Button>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SettingLabel}" Margin="0,8,0,0" Text="{Binding TokenStatusText}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" Foreground="{DynamicResource Brush.Danger.Text}" TextWrapping="Wrap"
                               Text="{DynamicResource TokenPlaintextWarning}"
                               Visibility="{Binding ShowPlaintextWarning, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <CheckBox IsChecked="{Binding AutoSyncEnabled, Mode=TwoWay}" VerticalAlignment="Center"
                                  AutomationProperties.Name="{DynamicResource AutoSync}" />
                        <TextBlock Style="{StaticResource SettingLabel}" Margin="8,0,0,0" Text="{DynamicResource AutoSync}" />
                    </StackPanel>
                    <!-- Indented and disabled with auto-sync: background sync is what
                         discovers new issues, so this does nothing on its own. -->
                    <StackPanel Orientation="Horizontal" Margin="24,8,0,0"
                                IsEnabled="{Binding AutoSyncEnabled}">
                        <CheckBox IsChecked="{Binding NotifyOnNewIssues, Mode=TwoWay}" VerticalAlignment="Center"
                                  AutomationProperties.Name="{DynamicResource NotifyNewIssues}" />
                        <TextBlock Style="{StaticResource SettingLabel}" Margin="8,0,0,0" Text="{DynamicResource NotifyNewIssues}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Data -->
            <Border Style="{StaticResource SettingsGroup}">
                <StackPanel>
                    <TextBlock Style="{StaticResource GroupHeader}" Text="{DynamicResource Data}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SettingLabel}" Text="{Binding DataFolder}" />
                        <Button Style="{DynamicResource WindowButton}" Padding="8,3" Command="{Binding OpenDataFolderCommand}" Content="{DynamicResource OpenFolder}"></Button>
                    </StackPanel>
                    <TextBlock Style="{StaticResource SettingLabel}" Margin="0,8,0,0"
                               Text="{DynamicResource DataFolderHint}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{DynamicResource WindowButton}" Padding="8,3" Command="{Binding ExportJsonCommand}" Content="{DynamicResource ExportJson}" />
                        <Button Style="{DynamicResource WindowButton}" Padding="8,3" Margin="10,0,0,0" Command="{Binding ExportCsvCommand}" Content="{DynamicResource ExportCsv}" />
                        <Button Style="{DynamicResource WindowButton}" Padding="8,3" Margin="10,0,0,0" Command="{Binding ImportJsonCommand}" Content="{DynamicResource ImportJson}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
