<Window x:Class="TaskTracker.Views.Windows.ColumnsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskTracker.Views.Windows"
        xmlns:controls="clr-namespace:TaskTracker.Controls"
        mc:Ignorable="d" WindowStyle="None"
        Title="ColumnsWindow" Height="380" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border Background="{DynamicResource Brush.Window.Background}" CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Border Height="30">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <Label Content="{DynamicResource EditColumns}" Foreground="{DynamicResource Brush.Text.Primary}" Margin="5,2,0,0" />
                    <Button Style="{DynamicResource TitleCloseButton}" Height="30" Width="46"
                            Click="CloseButton_Click" Grid.Column="1" HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="{DynamicResource WindowClose}">
                        <Path Style="{DynamicResource TitleBarGlyph}" Data="{DynamicResource Glyph.Close}" />
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10">
                <ItemsControl ItemsSource="{Binding Columns}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <controls:CustomTextBox Height="28" Text="{Binding Name, Mode=TwoWay}" />
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsDoneColumn, Mode=TwoWay}" VerticalAlignment="Center" Margin="10,0"
                                          Foreground="{DynamicResource Brush.Text.Primary}" Content="{DynamicResource DoneColumnFlag}" />
                                <TextBox Grid.Column="2" Width="42" Height="26" VerticalContentAlignment="Center" Margin="0,0,6,0"
                                         ToolTip="{DynamicResource WipLimitLabel}"
                                         Text="{Binding WipLimit, Mode=TwoWay, Converter={StaticResource NullableIntConverter}}" />
                                <Button Grid.Column="3" Style="{DynamicResource TitleButton}" Width="26" Height="26"
                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                        AutomationProperties.Name="{DynamicResource MoveUp}" ToolTip="{DynamicResource MoveUp}">▲</Button>
                                <Button Grid.Column="4" Style="{DynamicResource TitleButton}" Width="26" Height="26"
                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                        AutomationProperties.Name="{DynamicResource MoveDown}" ToolTip="{DynamicResource MoveDown}">▼</Button>
                                <Button Grid.Column="5" Style="{DynamicResource TitleButton}" Width="26" Height="26" Foreground="{DynamicResource Brush.Danger}"
                                        Command="{Binding DataContext.DeleteColumnCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                        AutomationProperties.Name="{DynamicResource Remove}" ToolTip="{DynamicResource Remove}">
                                    <Path Style="{DynamicResource GlyphPath}" Data="{DynamicResource Icon.Close}"
                                          Fill="{DynamicResource Brush.Danger.Text}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{DynamicResource WindowButton}" Padding="8,4" Command="{Binding AddColumnCommand}" Content="{DynamicResource AddColumn}" />
                <Button Grid.Column="2" Style="{DynamicResource WindowButton}" Padding="8,4" Click="CloseButton_Click" Content="{DynamicResource Close}" />
            </Grid>
        </Grid>
    </Border>
</Window>
