<Window x:Class="TaskTracker.Views.Windows.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskTracker.Views.Windows"
        xmlns:controls="clr-namespace:TaskTracker.Controls"
        mc:Ignorable="d" WindowStyle="None"
        Title="NewProjectWindow" Height="{Binding WindowHeight, Mode=OneTime}" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <!-- CaptionHeight matches the title strip below, so the chrome supplies the
         drag, double-click and system menu that DragMove() only approximated. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border Background="{DynamicResource Brush.Window.Background}" CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Border Grid.ColumnSpan="2" Height="30">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <Label Content="{Binding TitleString}" Foreground="{DynamicResource Brush.Text.Primary}" Margin="5,2,0,0" />

                    <Button Style="{DynamicResource TitleCloseButton}" Height="30" Width="46"
                            Click="CloseButton_Click" Grid.Column="1" HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="{DynamicResource WindowClose}">
                        <Path Style="{DynamicResource TitleBarGlyph}" Data="{DynamicResource Glyph.Close}" />
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Margin="10">
                <Label Foreground="{DynamicResource Brush.Text.Primary}" Content="{Binding NameString}"></Label>
                <controls:CustomTextBox Height="30" Text="{Binding Name, Mode=TwoWay}"></controls:CustomTextBox>
                <Label Margin="0,10,0,0" Foreground="{DynamicResource Brush.Text.Primary}" Content="{Binding DescriptionString}"></Label>
                <controls:CustomTextBox Height="30" Text="{Binding Description, Mode=TwoWay}"></controls:CustomTextBox>

                <!-- Project-only color picker -->
                <StackPanel Visibility="{Binding IsTaskMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=False}">
                    <Label Margin="0,10,0,0" Foreground="{DynamicResource Brush.Text.Primary}" Content="{DynamicResource ProjectColor}"></Label>
                    <ComboBox Width="140" Height="28" HorizontalAlignment="Left"
                              ItemsSource="{Binding ColorOptions}" SelectedItem="{Binding SelectedColor, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="14" Height="14" RadiusX="7" RadiusY="7" Stroke="{DynamicResource Brush.Border}" StrokeThickness="0.5"
                                               Fill="{Binding Converter={StaticResource ColorStringToBrushConverter}}" />
                                    <TextBlock Margin="6,0,0,0" Text="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Task-only fields -->
                <StackPanel Visibility="{Binding IsTaskMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Label Foreground="{DynamicResource Brush.Text.Primary}" Content="{DynamicResource DueDate}"></Label>
                            <DatePicker SelectedDate="{Binding DueDate, Mode=TwoWay}" Height="28" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Foreground="{DynamicResource Brush.Text.Primary}" Content="{DynamicResource Priority}"></Label>
                            <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding SelectedPriority, Mode=TwoWay}" Height="28" />
                        </StackPanel>
                    </Grid>
                    <Label Margin="0,10,0,0" Foreground="{DynamicResource Brush.Text.Primary}" Content="{DynamicResource LabelsCommaSeparated}"></Label>
                    <controls:CustomTextBox Height="30" Text="{Binding LabelsText, Mode=TwoWay}"></controls:CustomTextBox>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Button Click="Button_Click" Grid.Column="1" Margin="5" Padding="5" Style="{DynamicResource WindowButton}" Command="{Binding ConfirmCommand}" Content="{DynamicResource Confirm}"></Button>
                <Button Click="Button_Click" Grid.Column="2" Margin="5,5,10,5" Padding="5" Style="{DynamicResource WindowButton}" Command="{Binding CancelCommand}" Content="{DynamicResource Cancel}"></Button>
            </Grid>
        </Grid>
    </Border>
</Window>
