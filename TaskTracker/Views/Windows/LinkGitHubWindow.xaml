<Window x:Class="TaskTracker.Views.Windows.LinkGitHubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskTracker.Views.Windows"
        xmlns:controls="clr-namespace:TaskTracker.Controls"
        mc:Ignorable="d" WindowStyle="None"
        Title="LinkGitHubWindow" Height="300" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border Background="{DynamicResource Brush.Window.Background}" CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Border Grid.ColumnSpan="2" Height="30">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <Label Content="{DynamicResource LinkToGitHub}" Foreground="{DynamicResource Brush.Text.Primary}" Margin="5,2,0,0" />

                    <Button Style="{DynamicResource TitleCloseButton}" Height="30" Width="46"
                            Click="CloseButton_Click" Grid.Column="1" HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="{DynamicResource WindowClose}">
                        <Path Style="{DynamicResource TitleBarGlyph}" Data="{DynamicResource Glyph.Close}" />
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Margin="10">
                <Label Foreground="{DynamicResource Brush.Text.Primary}" Content="{DynamicResource GitHubOwner}"></Label>
                <controls:CustomTextBox Height="30" Text="{Binding Owner, Mode=TwoWay}"></controls:CustomTextBox>
                <Label Margin="0,10,0,0" Foreground="{DynamicResource Brush.Text.Primary}" Content="{DynamicResource GitHubRepo}"></Label>
                <controls:CustomTextBox Height="30" Text="{Binding Repo, Mode=TwoWay}"></controls:CustomTextBox>
            </StackPanel>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Button Click="Button_Click" Grid.Column="1" Margin="5" Padding="5" Style="{DynamicResource WindowButton}" Command="{Binding ConfirmCommand}" Content="{DynamicResource Confirm}"></Button>
                <Button Click="Button_Click" Grid.Column="2" Margin="5,5,10,5" Padding="5" Style="{DynamicResource WindowButton}" Command="{Binding CancelCommand}" Content="{DynamicResource Cancel}"></Button>
            </Grid>
        </Grid>
    </Border>
</Window>
