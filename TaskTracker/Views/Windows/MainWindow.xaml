<Window x:Class="TaskTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskTracker"
        xmlns:controls="clr-namespace:TaskTracker.Controls"
        mc:Ignorable="d"
        Style="{DynamicResource WindowStyle}"
        WindowState="{Binding WindowState}"
        WindowStyle="None"
        ResizeMode="CanResize"
        Title="TaskTracker" Height="800" Width="1200"
        MinHeight="520" MinWidth="880"
        FontFamily="{DynamicResource Font.UI}"
        WindowStartupLocation="CenterScreen">
    <!-- WindowChrome keeps the native window behaviour (Aero Snap, Win+Arrow,
         double-click to maximize, real resize borders) while letting the caption
         be templated. Maximized bounds are corrected by WindowMaximizeFix. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="N" Command="{Binding NewProjectClickCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="T" Command="{Binding NewTaskShortcutCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Two-way: the GridSplitter assigns this Width, which the binding turns
                 into a stored preference. -->
            <ColumnDefinition x:Name="SidebarColumn"
                              Width="{Binding SidebarWidth, Mode=TwoWay, Converter={StaticResource SidebarWidthConverter}}"
                              MinWidth="180" MaxWidth="420" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==== Sidebar ====
             Three rows: a fixed header, a list that takes the slack, and a footer
             pinned to the bottom. It used to be a StackPanel, a ScrollViewer with
             Margin="0,0,0,120" to reserve room, and a DockPanel overlaid in the same
             grid cell — so the footer silently sat on top of the list whenever the
             list grew past the space guessed for it. -->
        <Grid Margin="8,0,4,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Style="{StaticResource Text.Title}" Text="{DynamicResource Projects}"
                           Margin="8,0,0,12" />

                <controls:ProjectItem IsChecked="{Binding IsHomeSelected}"
                                      Command="{Binding NavigateToHomeCommand}"
                                      GroupName="checkboxes"
                                      Icon="{StaticResource Icon.Home}"
                                      Content="{DynamicResource Home}" />

                <controls:ProjectItem IsChecked="{Binding IsAgendaSelected}"
                                      Command="{Binding NavigateToAgendaCommand}"
                                      GroupName="checkboxes"
                                      Icon="{StaticResource Icon.Calendar}"
                                      Content="{DynamicResource Agenda}" />

                <Rectangle Height="1" Margin="4,8" Fill="{DynamicResource Brush.Divider}" />

                <controls:CustomTextBox x:Name="SearchBox" Height="32" Margin="0,0,0,4"
                                        AutomationProperties.Name="{DynamicResource SearchHint}"
                                        Hint="{DynamicResource SearchHint}"
                                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Button Style="{DynamicResource SubtleButton}" HorizontalAlignment="Right"
                        Padding="8,2" Margin="0,0,0,4"
                        Command="{Binding SortClickCommand}" Content="{DynamicResource Sort}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding ShownProjects}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:ProjectItem Command="{Binding DataContext.NavigateToProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Id}"
                                        GroupName="checkboxes"
                                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                        Tag="IsProject"
                                        Icon="{StaticResource Icon.Project}"
                                        AutomationProperties.Name="{Binding Name}"
                                        Margin="0,1">
                                <StackPanel Orientation="Horizontal">
                                    <!-- The project's own colour, when it has one: the only
                                         colour in the row, so it identifies rather than decorates. -->
                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                             Fill="{Binding Color, Converter={StaticResource ColorStringToBrushConverter}}" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </controls:ProjectItem>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Nothing to show yet: the sidebar is otherwise a blank column on a
                 first run, with no hint that a project is what starts things off. -->
            <TextBlock Grid.Row="1" Style="{StaticResource Text.Caption}"
                       Text="{DynamicResource NoProjectsYet}"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="12,24"
                       VerticalAlignment="Top" IsHitTestVisible="False"
                       Visibility="{Binding ShownProjects.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Empty}" />

            <StackPanel Grid.Row="2">
                <Rectangle Height="1" Margin="4,8" Fill="{DynamicResource Brush.Divider}" />
                <controls:SideBarItem Command="{Binding NewProjectClickCommand}"
                                      Icon="{StaticResource Icon.Add}"
                                      Content="{DynamicResource AddProject}" />
                <controls:ProjectItem Content="{DynamicResource Settings}"
                                      IsChecked="{Binding IsSettingsSelected}"
                                      Command="{Binding NavigateToSettingsCommand}"
                                      GroupName="checkboxes"
                                      Icon="{StaticResource Icon.Settings}"
                                      Margin="0,1,0,0" />
            </StackPanel>
        </Grid>

        <!-- Resizable so long project names are reachable without truncation. -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                      Background="Transparent" Cursor="SizeWE"
                      AutomationProperties.Name="{DynamicResource ResizeSidebar}" />

        <Border Grid.Column="2" Margin="0,0,8,8"
                CornerRadius="{DynamicResource Radius.Panel}"
                Background="{DynamicResource Brush.Content.Background}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <Grid>
                <!-- Page, then the two transient strips stacked beneath it. Separate rows
                     rather than one: both can be up at once (delete a card while a timer
                     runs) and in a shared row they would draw on top of each other. -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <ContentControl Margin="{DynamicResource Pad.Page}"
                                Content="{Binding NavigationService.CurrentView}" />

                <!-- Undo bar. In the shell because the actions it covers span pages —
                     archiving and deleting a project both navigate away from the board
                     that started them, so a bar living on that board would leave with it. -->
                <Border Grid.Row="1" Padding="12,8" Margin="8,0,8,8"
                        CornerRadius="{DynamicResource Radius.Card}"
                        Background="{DynamicResource Brush.Card.Background}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        Visibility="{Binding Undo.IsVisible, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Body}" VerticalAlignment="Center"
                                   Text="{Binding Undo.Text}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Undo.Text}" />
                        <Button Grid.Column="1" Style="{DynamicResource SubtleButton}" Padding="12,2" Margin="12,0,0,0"
                                Command="{Binding Undo.UndoCommand}"
                                Content="{DynamicResource Undo}" />
                    </Grid>
                </Border>

                <!-- Running-timer strip. In the shell rather than the board because the
                     timer belongs to the store, not to whichever project happens to be
                     open: it used to be visible only in the task detail drawer, so
                     closing the drawer left it running out of sight. -->
                <Border Grid.Row="2" Padding="12,8" Margin="8,0,8,8"
                        CornerRadius="{DynamicResource Radius.Card}"
                        Background="{DynamicResource Brush.Card.Background}"
                        BorderBrush="{DynamicResource Brush.Accent.Strong}" BorderThickness="1"
                        Visibility="{Binding IsTimerRunning, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>

                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0"
                                 Fill="{DynamicResource Brush.Accent.Strong}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" VerticalAlignment="Center"
                                   Text="{Binding RunningTimerTitle}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding RunningTimerTitle}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Text.BodyStrong}" VerticalAlignment="Center"
                                   Margin="12,0,12,0" Text="{Binding RunningTimerText}" />
                        <Button Grid.Column="3" Style="{DynamicResource SubtleButton}" Padding="10,2"
                                Command="{Binding StopRunningTimerCommand}"
                                Content="{DynamicResource StopTimer}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
