<Window x:Class="TaskTracker.Views.Windows.SortProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskTracker.Views.Windows"
        mc:Ignorable="d" Background="Transparent" WindowStyle="None"
        Title="SortProjectWindow" Height="230" Width="360"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        ResizeMode="CanResize">
    <Border Background="{DynamicResource Brush.Window.Background}" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Border Grid.ColumnSpan="2" Height="30">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <Label Content="{DynamicResource SortProjects}" Foreground="{DynamicResource Brush.Text.Primary}" Margin="5,2,0,0" />

                    <Rectangle Fill="Transparent" MouseLeftButtonDown="Rectangle_MouseLeftButtonDown" />

                    <Button Style="{DynamicResource TitleButton}" Height="30" Width="30" Click="CloseButton_Click" Grid.Column="1" HorizontalAlignment="Right">✖</Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Margin="10">
                <CheckBox Margin="5" Foreground="{DynamicResource Brush.Text.Primary}" IsChecked="{Binding IsShowEmpty}" Content="{DynamicResource ShowEmpty}"></CheckBox>
                <CheckBox Margin="5" Foreground="{DynamicResource Brush.Text.Primary}" IsChecked="{Binding IsShowDone}" Content="{DynamicResource ShowDone}"></CheckBox>
                <CheckBox Margin="5" Foreground="{DynamicResource Brush.Text.Primary}" IsChecked="{Binding IsShowOnlyFav}" Content="{DynamicResource ShowOnlyFavourite}"></CheckBox>
                <CheckBox Margin="5" Foreground="{DynamicResource Brush.Text.Primary}" IsChecked="{Binding IsShowArchived}" Content="{DynamicResource ShowArchived}"></CheckBox>
            </StackPanel>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Button Click="Button_Click" Grid.Column="1" Margin="5" Padding="5" Style="{DynamicResource WindowButton}" Command="{Binding ConfirmCommand}" Content="{DynamicResource Confirm}"></Button>
                <Button Click="Button_Click" Grid.Column="2" Margin="5,5,10,5" Padding="5" Style="{DynamicResource WindowButton}" Command="{Binding CancelCommand}" Content="{DynamicResource Cancel}"></Button>
            </Grid>
        </Grid>
    </Border>
</Window>
