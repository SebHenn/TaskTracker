<Application x:Class="TaskTracker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TaskTracker"
             xmlns:viewModelPages="clr-namespace:TaskTracker.ViewModels.Pages"
             xmlns:viewModelWindows="clr-namespace:TaskTracker.ViewModels.Windows"
             xmlns:windowsViews="clr-namespace:TaskTracker.Views.Windows"
             xmlns:pagesViews="clr-namespace:TaskTracker.Views.Pages">
    <Application.Resources>
        <ResourceDictionary>
            <DataTemplate DataType="{x:Type viewModelPages:HomeViewModel}">
                <pagesViews:HomeView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModelPages:SettingsViewModel}">
                <pagesViews:SettingsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModelPages:ProjectViewModel}">
                <pagesViews:ProjectView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModelPages:SearchViewModel}">
                <pagesViews:SearchView/>
            </DataTemplate>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Shared.xaml"/>
                <ResourceDictionary Source="Styles/DarkMode.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
