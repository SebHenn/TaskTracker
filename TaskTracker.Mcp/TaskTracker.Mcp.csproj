<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TaskTracker.Core\TaskTracker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The CreateStore / CreateSettingsStore seams are internal; the tests point them
         at a temp directory, which is the only way to exercise a handler end to end. -->
    <InternalsVisibleTo Include="TaskTracker.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- See TaskTracker.Core.csproj: warning-free today, kept that way here. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Packable as a global tool, so another repository can register the server as
       plain `tasktracker-mcp` instead of an absolute path into a clone of this one.
       A path is machine-specific and cannot be committed to a shared .mcp.json. -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tasktracker-mcp</ToolCommandName>
    <PackageId>SebHenn.TaskTracker.Mcp</PackageId>
    <!-- Bump this in the same commit as any behaviour change here or in Core: an
         installed tool is a snapshot, and `dotnet tool update` no-ops on an equal
         version, so forgetting leaves users on old code with no signal. Major for a
         removed/renamed tool or a changed response shape, minor for a new tool, patch
         for a fix. store_info reports the running value. -->
    <Version>2.0.0</Version>
    <Description>MCP stdio server for TaskTracker: manage projects, tasks, board columns, checklists, trash and GitHub links from any MCP client.</Description>
    <Authors>Sebastian Henn</Authors>
    <PackageTags>mcp;tasktracker;claude;model-context-protocol</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/SebHenn/TaskTracker</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SebHenn/TaskTracker</RepositoryUrl>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts\nupkg</PackageOutputPath>
    <!-- The tool targets net8.0 but gets installed on machines whose newest runtime is
         all they have; without this it refuses to start there. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

</Project>
